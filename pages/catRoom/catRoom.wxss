}
.dream-postcard__action text {
  font-size: 20rpx;
  font-weight: 600;
  font-family: 'Inter', -apple-system, sans-serif;
  color: #8A5A2B;
}
/* 已保存进物品库：按钮压成灰调，点它只会提示 */
.dream-postcard__action--done {
  background: #FBF3E4;
  border-color: #EFD9B8;
}
.dream-postcard__action--done text {
  color: #A99A86;
}
/* 用户自己写的那句（对话框里保存后显示） */
.dream-postcard__mine {
