}

.dream-postcard__result {
  margin-top: 16rpx;
  font-size: 20rpx;
  font-family: 'Londrina Solid', 'PingFang SC', cursive;
  color: #796E2E;
  line-height: 2;
  word-break: break-word;
  white-space: pre-wrap;
}

/* ============================================================
   解梦对话框（Figma 1190_148）· 点「解析」弹出
   规格（px → 2rpx/px，对话框宽度 ≈ 屏幕一半）：
     面板 189×161
     标题栏 189×36 · rgba(226,217,246,.54) · 圆角 9
            图标 24 (距左 11,上 6) + 标题 10 Microsoft YaHei
     输入区 189×91 · rgba(183,156,250,.31) · 圆角 9 · 占位「给猫解析一下」10 居中
     工具条 189×30 · rgba(183,156,250,.42) · 圆角 11
            3 个 24 图标等距（间距 15；原画布 4 个，曲别针已去掉）
   ============================================================ */
.dream-dialog {
  position: fixed;
  inset: 0;
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 键盘弹起时由行内样式补 padding-bottom，把面板整体推上去 */
  transition: padding-bottom 200ms ease;
}
.dream-dialog__mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
}
.dream-dialog__panel {
  position: relative;
  z-index: 1;
  width: 378rpx;
  /* 设计稿里标题栏/输入区/语音条/工具条都是半透明色，面板没底色时整片会透出遮罩，
     这里垫一层不透明白底：半透明色叠在白底上的观感和设计稿一致，但不再透背景 */
  background: #FFFFFF;
  border-radius: 18rpx;
  box-shadow: 0 22rpx 56rpx rgba(44, 34, 30, 0.18);
  overflow: hidden;                /* 白底圆角跟着各块的圆角，不留白边 */
  animation: dreamDialogIn 200ms ease-out;
}
@keyframes dreamDialogIn {
  from { opacity: 0; transform: translateY(24rpx) scale(0.96); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

/* 标题栏 */
.dream-dialog__head {
  height: 72rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  background: rgba(226, 217, 246, 0.54);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
}
.dream-dialog__head-icon {
  flex: 0 0 auto;
  width: 48rpx;
  height: 48rpx;
}
.dream-dialog__head-title {
  margin-left: 16rpx;
  font-size: 20rpx;
  font-family: 'Microsoft YaHei', -apple-system, sans-serif;
  color: #000000;
  letter-spacing: 1rpx;
}

/* 输入区（占位居中，和设计稿一致） */
.dream-dialog__input {
  width: 100%;
  height: 182rpx;
  margin-top: 4rpx;
  padding: 44rpx 36rpx;
  box-sizing: border-box;
  background: rgba(183, 156, 250, 0.31);
  border-radius: 18rpx;
  font-size: 20rpx;
  line-height: 1.7;
  color: #2F2F2F;
  text-align: center;
}
.dream-dialog__placeholder {
  font-size: 20rpx;
  color: rgba(0, 0, 0, 0.28);
  text-align: center;
}

/* 语音条（录音中 / 录完才出现） */
.dream-dialog__voice {
  height: 56rpx;
  margin-top: 4rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  background: rgba(183, 156, 250, 0.42);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
}
.dream-dialog__voice-play {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.dream-dialog__voice-icon {
  width: 40rpx;
  height: 40rpx;
}
.dream-dialog__voice-text {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
  font-size: 20rpx;
  font-family: 'Microsoft YaHei', -apple-system, sans-serif;
  color: #2F2F2F;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.dream-dialog__voice-del {
  flex: 0 0 auto;
  padding: 8rpx 0 8rpx 16rpx;
  font-size: 20rpx;
  font-family: 'Microsoft YaHei', -apple-system, sans-serif;
  color: #5B4A9B;
}

/* 工具条：保存 / 语音 / 清空 */
.dream-dialog__tools {
  height: 60rpx;
  margin-top: 4rpx;
  padding: 0 30rpx;
  box-sizing: border-box;
  background: rgba(183, 156, 250, 0.42);
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 30rpx;
}
.dream-dialog__tool {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.dream-dialog__tool-icon {
  width: 48rpx;
  height: 48rpx;
}
.dream-dialog__tool--hover {
  opacity: 0.65;
}
/* 录音中：麦克风带红点呼吸 */
.dream-dialog__tool--rec {
  border-radius: 50%;
  background: rgba(255, 92, 92, 0.92);
  animation: dreamRecPulse 900ms ease-in-out infinite;
}
@keyframes dreamRecPulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50%      { transform: scale(1.12); opacity: 0.78; }
}

/* ============================================================
   物品（Figma 404_658）：猫外出留在家里的东西
   卡 356×143px · #FFDBB3 圆角 17
   3 按钮 100×26 · 白底 + #FFDBB3 描边 · 文字 #8A5A2B 12 600
   ============================================================ */
.item-view {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}
.item-list {
  width: 100%;
  max-height: 720rpx;          /* 列表区，超过可滚 */
  box-sizing: border-box;
}
.item-card {
  width: 600rpx;
  margin: 0 auto 18rpx;
  padding: 22rpx 24rpx 18rpx;
  box-sizing: border-box;
  background: #FFDBB3;
  border-radius: 34rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 14rpx 32rpx rgba(138, 90, 43, 0.10);
}
.item-card__icon {
  width: 90rpx;
  height: 90rpx;
  flex: 0 0 auto;
}
.item-card__title {
  font-size: 26rpx;
  font-weight: 500;
  font-family: 'Inter', -apple-system, sans-serif;
  color: #2F2F2F;
  text-align: center;
  line-height: 1.3;
  word-break: break-word;
}
.item-card__actions {
  width: 100%;
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}
.item-action {
  flex: 1;
  height: 50rpx;
  background: #FFFFFF;
  border: 2rpx solid #FFDBB3;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 120ms ease, color 120ms ease;
}
.item-action text {
  font-size: 22rpx;
  font-weight: 600;
  font-family: 'Inter', -apple-system, sans-serif;
  color: #8A5A2B;
}
.item-action--on {
  background: #8A5A2B;
}
.item-action--on text { color: #FFFFFF; }
.item-action--hover { opacity: 0.85; }

/* 物品下挂的留言摘要 */
.item-note {
  width: 100%;
  margin-top: 4rpx;
  padding: 12rpx 18rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.item-note__tag {
  font-size: 19rpx;
  font-weight: 600;
  font-family: 'Inter', -apple-system, sans-serif;
  color: #8A5A2B;
  letter-spacing: 1rpx;
}
.item-note__text {
  font-size: 24rpx;
  line-height: 1.45;
  color: #2F2F2F;
  word-break: break-word;
  white-space: pre-wrap;
}

.item-empty {
  padding: 60rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 26rpx;
  color: #A99A86;
  letter-spacing: 2rpx;
}

