/* ============================================
   chat.wxss — 微信风格对话页
   ============================================ */

page {
  min-height: 100vh;
  background: #EDEDED;
}

.page {
  width: 100%;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #EDEDED;
}

/* ============================================
   顶部导航栏
   ============================================ */
.chat-nav {
  width: 100%;
  height: 96rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #EDEDED;
  border-bottom: 1rpx solid #D9D9D9;
  padding-top: env(safe-area-inset-top);
}

.chat-nav__back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.chat-nav__back-icon {
  font-size: 52rpx;
  font-weight: 300;
  color: #101828;
  line-height: 1;
}

.chat-nav__center {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
}

.chat-nav__avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #FFD500;
}

.chat-nav__info {
  display: flex;
  flex-direction: column;
}

.chat-nav__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #101828;
  line-height: 1.3;
}

.chat-nav__status {
  font-size: 20rpx;
  color: #34D399;
}

/* ============================================
   消息列表
   ============================================ */
.msg-list {
  flex: 1;
  width: 100%;
  padding: 0 28rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

/* 时间分隔 */
.msg-time {
  display: flex;
  justify-content: center;
  padding: 24rpx 0 16rpx;
}

.msg-time__text {
  font-size: 22rpx;
  color: #B3B3B3;
  background: #E3E3E3;
  border-radius: 6rpx;
  padding: 4rpx 16rpx;
}

/* 消息行 */
.msg-row {
  display: flex;
  flex-direction: row;
  margin-bottom: 20rpx;
}

.msg-row--cat {
  justify-content: flex-start;
}

.msg-row--user {
  justify-content: flex-end;
}

/* 头像 */
.msg-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.msg-avatar--cat {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #FFD500;
  overflow: hidden;
}

.msg-avatar--user {
  background: #6155F5;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.msg-avatar__me {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.msg-avatar__img {
  width: 100%;
  height: 100%;
}

/* 气泡 */
.msg-bubble {
  max-width: 440rpx;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  position: relative;
}

.msg-row--cat .msg-bubble {
  margin-left: 14rpx;
}

.msg-row--user .msg-bubble {
  margin-right: 14rpx;
}

.msg-bubble--cat {
  background: #FFFFFF;
  border: 1rpx solid #EBEBEB;
  border-radius: 4rpx 14rpx 14rpx 14rpx;
}

.msg-bubble--user {
  background: #95EC69;
  border-radius: 14rpx 4rpx 14rpx 14rpx;
}

.msg-text {
  font-size: 28rpx;
  color: #101828;
  line-height: 1.6;
  word-break: break-all;
}

.msg-text--user {
  color: #101828;
}

/* 正在输入动画 */
.msg-bubble--typing {
  padding: 22rpx 32rpx;
}

.typing-dots {
  display: flex;
  flex-direction: row;
  gap: 10rpx;
}

.typing-dot {
  width: 14rpx;
  height: 14rpx;
  background: #C0C0C0;
  border-radius: 50%;
  animation: typingBounce 1.2s infinite ease-in-out;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.15s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes typingBounce {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.4;
  }
  30% {
    transform: translateY(-12rpx);
    opacity: 1;
  }
}

/* 底部占位 */
.msg-bottom {
  height: 32rpx;
}

/* ============================================
   底部输入栏
   ============================================ */
.input-bar {
  width: 100%;
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 14rpx 24rpx;
  box-sizing: border-box;
  background: #F7F7F7;
  border-top: 1rpx solid #D9D9D9;
  gap: 16rpx;
}

.input-bar__field {
  flex: 1;
  height: 68rpx;
  background: #FFFFFF;
  border-radius: 10rpx;
  padding: 0 18rpx;
  font-size: 28rpx;
  color: #101828;
  box-sizing: border-box;
}

.input-bar__placeholder {
  color: #B3B3B3;
}

.input-bar__send {
  width: 120rpx;
  height: 68rpx;
  border-radius: 10rpx;
  background: #D9D9D9;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.input-bar__send--active {
  background: #95EC69;
}

.input-bar__send-text {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.6);
}

.input-bar__send--active .input-bar__send-text {
  color: #101828;
}


