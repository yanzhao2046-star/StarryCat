/* ========== 页面容器（对齐 youMeOther — 左右 60rpx） ========== */
.page {
  width: 100%;
  height: 100vh;
  position: relative;
  display: flex;
  flex-direction: column;
  background: #FFFFFF;
}

.page-body {
  flex: 1;
  padding: 0 60rpx;
  box-sizing: border-box;
}

/* ========== 上半区容器：头部 + 聊天 ========== */
.chat-area {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ========== 头部 ========== */
.chat-header {
  padding: 24rpx 0 20rpx;
  background: #FFFFFF;
  flex-shrink: 0;
}

.header-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #101828;
  line-height: 1.4;
}

.header-mycatter-btn {
  padding: 12rpx 28rpx;
  background: #7C3AED;
  border-radius: 24rpx;
  transition: opacity 0.2s;
}

.header-mycatter-btn--hover {
  opacity: 0.8;
}

.header-mycatter-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.header-subtitle {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #101828;
  margin-top: 8rpx;
  line-height: 1.4;
}

/* ========== 聊天消息区 ========== */
.chat-body {
  flex: 1;
  background: #F6F6F6;
  padding: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.chat-messages {
  padding-top: 20rpx;
  padding-bottom: 16rpx;
}

/* 空状态 */
.chat-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-cat-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  background: #F0E6FF;
  margin-bottom: 24rpx;
}

.empty-tip {
  font-size: 28rpx;
  color: #999;
}

/* 时间分割线 */
.msg-time {
  text-align: center;
  font-size: 22rpx;
  color: #C4C4C4;
  margin: 20rpx 0 12rpx;
}

/* 消息行 */
.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.msg-row--ai {
  flex-direction: row;
}

.msg-row--user {
  flex-direction: row-reverse;
}

.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #F0E6FF;
}

.msg-row--ai .msg-avatar {
  margin-right: 30rpx;
}

.msg-row--user .msg-avatar {
  margin-left: 30rpx;
}

/* 消息气泡 */
.msg-bubble {
  max-width: 470rpx;
  padding: 14rpx 18rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  line-height: 1.55;
  word-break: break-all;
  position: relative;
}

.msg-bubble--ai {
  background: #FFFFFF;
  color: #2F2F2F;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

.msg-bubble--user {
  background: #965ED7;
  color: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

/* 气泡尾巴（CSS 三角形，颜色与气泡一致） */
.bubble-tail {
  position: absolute;
  width: 0;
  height: 0;
  top: 14rpx;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
}

.bubble-tail--ai {
  left: -10rpx;
  border-right: 10rpx solid #FFFFFF;
}

.bubble-tail--user {
  right: -10rpx;
  border-left: 10rpx solid #965ED7;
}

/* 输入中动画 */
.msg-bubble--typing {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  min-width: 100rpx;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #C4C4C4;
  animation: typingBounce 1.4s ease-in-out infinite both;
}

.typing-dot:nth-child(1) { animation-delay: 0s; }
.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typingBounce {
  0%, 60%, 100% { opacity: 0.3; transform: scale(0.8); }
  30% { opacity: 1; transform: scale(1); }
}

/* ========== 输入区域 ========== */
.chat-input-bar {
  display: flex;
  align-items: center;
  padding: 12rpx 60rpx;
  padding-bottom: calc(12rpx + 96rpx + env(safe-area-inset-bottom));
  background: #F5F5F5;
  border-top: 1rpx solid #E5E5E5;
  gap: 12rpx;
  flex-shrink: 0;
}

/* 工具按钮（语音 / 表情 / +） */
.input-tool-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  flex-shrink: 0;
  transition: background 0.15s;
}

.input-tool-btn--hover {
  background: rgba(0,0,0,0.05);
}

.input-tool-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 文本输入框 */
.chat-input {
  flex: 1;
  height: 68rpx;
  background: #FFFFFF;
  border-radius: 8rpx;
  padding: 0 22rpx;
  font-size: 28rpx;
  color: #101828;
}

.input-placeholder {
  color: #B0B0B0;
  font-size: 28rpx;
}

/* 语音录制按钮 */
.voice-hold-btn {
  flex: 1;
  height: 68rpx;
  background: #FFFFFF;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #E5E5E5;
  transition: all 0.15s;
}

.voice-hold-btn--active {
  background: #7C3AED;
  border-color: #7C3AED;
}

.voice-hold-btn--hover {
  background: #F0E6FF;
}

.voice-hold-btn--active.voice-hold-btn--hover {
  background: #6D28D9;
}

.voice-hold-text {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.voice-hold-btn--active .voice-hold-text {
  color: #FFFFFF;
}

/* ========== 面板通用 ========== */
.panel {
  background: #F5F5F5;
  border-top: 1rpx solid #E5E5E5;
  overflow: hidden;
  max-height: 0;
  transition: max-height 0.25s ease;
  flex-shrink: 0;
  padding: 0 60rpx;
}

.panel--show {
  max-height: 440rpx;
}

/* ========== 表情面板 ========== */
.emoji-scroll {
  height: 400rpx;
}

.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 12rpx;
}

.emoji-item {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  transition: background 0.1s;
}

.emoji-item:active {
  background: rgba(0,0,0,0.08);
}

.emoji-char {
  font-size: 44rpx;
  line-height: 1;
}

/* ========== 更多功能面板 ========== */
.more-panel.panel--show {
  max-height: 280rpx;
}

.more-grid {
  display: flex;
  padding: 28rpx 24rpx;
  gap: 40rpx;
}

.more-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.more-icon-box {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  transition: background 0.15s;
}

.more-icon-box:active {
  background: #E8E8E8;
}

.more-label {
  font-size: 24rpx;
  color: #666;
}

/* ========== 底部导航栏（来自 youMeOther） ========== */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: #ffffff;
  width: 100%;
  height: 96rpx;
  flex-shrink: 0;
  padding: 0 60rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #000000;
}

.tab-item.active .tab-label {
  color: #6155F5;
  font-weight: 700;
}
