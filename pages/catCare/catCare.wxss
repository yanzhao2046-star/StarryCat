/* ========== 页面容器（对齐 youMeOther — 左右 60rpx） ========== */
.page {
  width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 60rpx;
  display: flex;
  flex-direction: column;
  background: #FFFFFF;
}

/* ========== 上半区容器：头部 + 聊天 ========== */
.chat-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ========== 头部 ========== */
.chat-header {
  padding: 24rpx 0 20rpx;
  background: #FFFFFF;
  flex-shrink: 0;
}

.header-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #101828;
  line-height: 1.4;
}

.header-mycatter-btn {
  padding: 12rpx 28rpx;
  background: #7C3AED;
  border-radius: 24rpx;
  transition: opacity 0.2s;
}

.header-mycatter-btn--hover {
  opacity: 0.8;
}

.header-mycatter-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.header-subtitle {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #101828;
  margin-top: 8rpx;
  line-height: 1.4;
}

/* ========== 聊天消息区 ========== */
.chat-body {
  flex: 1;
  background: #F6F6F6;
  padding: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.chat-messages {
  padding-top: 20rpx;
  padding-bottom: 16rpx;
}

/* 空状态 */
.chat-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-cat-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  background: #F0E6FF;
  margin-bottom: 24rpx;
}

.empty-tip {
  font-size: 28rpx;
  color: #999;
}

/* 时间分割线 */
.msg-time {
  text-align: center;
  font-size: 22rpx;
  color: #C4C4C4;
  margin: 20rpx 0 12rpx;
}

/* 消息行 */
.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.msg-row--ai {
  flex-direction: row;
}

.msg-row--user {
  flex-direction: row-reverse;
}

.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #F0E6FF;
}

.msg-row--ai .msg-avatar {
  margin-right: 16rpx;
}

.msg-row--user .msg-avatar {
  margin-left: 16rpx;
}

/* 消息气泡 */
.msg-bubble {
  max-width: 470rpx;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #101828;
  word-break: break-all;
  position: relative;
}

.msg-bubble--ai {
  background: #FFFFFF;
  border-top-left-radius: 6rpx;
}

.msg-bubble--user {
  background: #7C3AED;
  color: #FFFFFF;
  border-top-right-radius: 6rpx;
}

/* 输入中动画 */
.msg-bubble--typing {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  min-width: 100rpx;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #C4C4C4;
  animation: typingBounce 1.4s ease-in-out infinite both;
}

.typing-dot:nth-child(1) { animation-delay: 0s; }
.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typingBounce {
  0%, 60%, 100% { opacity: 0.3; transform: scale(0.8); }
  30% { opacity: 1; transform: scale(1); }
}

/* ========== 输入区域 ========== */
.chat-input-bar {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #EEEEEE;
  gap: 16rpx;
  flex-shrink: 0;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  background: #F6F6F6;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #101828;
}

.input-placeholder {
  color: #B0B0B0;
  font-size: 28rpx;
}

.chat-send-btn {
  width: 112rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: #E8E8E8;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s;
  flex-shrink: 0;
}

.chat-send-btn--active {
  background: #7C3AED;
}

.chat-send-btn--hover {
  opacity: 0.8;
}

.chat-send-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
}

/* ========== 底部导航栏（来自 youMeOther） ========== */
.tab-bar {
  width: 100%;
  height: 96rpx;
  flex-shrink: 0;
  margin-top: auto;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #000000;
}

.tab-item.active .tab-label {
  color: #6155F5;
  font-weight: 700;
}
