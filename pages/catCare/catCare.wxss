/* ============================================
   catCare.wxss — 星猫说
   Figma 基准：375px → 750rpx (1px = 2rpx)
   ============================================ */

page {
  background: #FFFFFF;
  min-height: 100vh;
}

.page {
  width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 60rpx;
  display: flex;
  flex-direction: column;
}

.cat-body {
  flex: 1;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

/* ============================================
   顶部标题区
   ============================================ */
.header {
  width: 100%;
  margin-top: 0;
  padding-top: 24rpx;
  padding-bottom: 12rpx;
  box-sizing: border-box;
  background: linear-gradient(160deg, #FFF1F2 0%, #FFFFFF 70%);
  border-radius: 0 0 20rpx 20rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.header-avatar-wrap {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.header-avatar {
  width: 120rpx;
  height: 120rpx;
}

.header-text {
  margin-left: 4rpx;
  display: flex;
  flex-direction: column;
}

.header-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #101828;
}

.header-subtitle {
  font-size: 38rpx;
  font-weight: 700;
  color: #101828;
  margin-top: 2rpx;
}

/* ============================================
   星猫个性问候气泡
   ============================================ */
.greeting-bubble {
  margin-top: 16rpx;
  padding: 18rpx 28rpx;
  background: linear-gradient(135deg, #FFF1F2, #FFF);
  border-radius: 20rpx;
  border: 1rpx solid #FEE2E5;
}

.greeting-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #475569;
  line-height: 1.5;
}

/* ============================================
   "和星猫聊心事"入口按钮
   ============================================ */
.chat-entry-btn {
  margin-top: 20rpx;
  padding: 22rpx 28rpx;
  background: #FFFFFF;
  border: 2rpx solid #E8E5FF;
  border-radius: 18rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  box-sizing: border-box;
}

.chat-entry-btn:active {
  background: #F8F7FF;
}

.chat-entry-btn__icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.chat-entry-btn__text {
  flex: 1;
  margin-left: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #6155F5;
}

.chat-entry-btn__arrow {
  font-size: 28rpx;
  color: #6155F5;
  font-weight: 600;
}

/* ============================================
   对话输入框组件（Figma 原版）
   ============================================ */
.input-card {
  width: 100%;
  margin-top: 20rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  border: 1rpx solid #D9D9D9;
  box-sizing: border-box;
  padding: 28rpx 32rpx;
}

.ic-placeholder-wrap {
  margin-bottom: 52rpx;
}

.ic-placeholder {
  font-size: 32rpx;
  font-weight: 400;
  color: #B3B3B3;
}

.ic-toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.ic-tools-left {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.ic-tool-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ic-tool-icon {
  width: 40rpx;
  height: 40rpx;
}

.ic-send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ic-send-btn--disabled {
  background: #D9D9D9;
  border: 2rpx solid #B3B3B3;
}

.ic-send-icon {
  width: 40rpx;
  height: 40rpx;
}

/* ============================================
   说明文字
   ============================================ */
.tip-text {
  margin-top: 28rpx;
  margin-bottom: 12rpx;
}

.tip-text text {
  font-size: 32rpx;
  font-weight: 290;
  color: #000000;
}

/* ============================================
   星星猫数值卡片
   ============================================ */
.stats-card {
  width: 100%;
  margin-top: 0;
  box-sizing: border-box;
}

.sc-top {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.sc-cat-circle {
  width: 330rpx;
  height: 330rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sc-cat-img {
  width: 248rpx;
  height: 248rpx;
}

.sc-stats {
  flex: 1;
  margin-left: 4rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.sc-stat-line {
  font-size: 32rpx;
  font-weight: 290;
  color: #000000;
}

/* 等级进度条包裹 */
.sc-progress-wrap {
  width: 100%;
  margin-top: 12rpx;
}

/* 渐变进度条（底色） */
.sc-progress-bar {
  width: 100%;
  height: 38rpx;
  background: #E8E5FF;
  border-radius: 1876rpx;
  overflow: hidden;
}

/* 进度条填充（从左到右增长） */
.sc-progress-fill {
  height: 100%;
  border-radius: 1876rpx;
  background: linear-gradient(90deg, #D9D9D9 0%, #6155F5 100%);
  transition: width 0.5s ease;
}

/* 等级称号文字 */
.sc-level-text {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #6155F5;
  text-align: right;
}

/* ============================================
   成长规则卡片
   ============================================ */
.grow-rules-card {
  width: 100%;
  margin-top: 28rpx;
  padding-bottom: 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.gr-tag {
  padding: 8rpx 20rpx;
  background: #BA99ED;
  border-radius: 18rpx;
  font-size: 24rpx;
  font-weight: 290;
  color: #000000;
  line-height: 1.2;
  margin-bottom: 14rpx;
}

.gr-img {
  width: 100%;
  border-radius: 16rpx;
  display: block;
}

/* ============================================
   底部 Tab 栏
   ============================================ */
.tab-bar {
  width: 100%;
  height: 96rpx;
  flex-shrink: 0;
  margin-top: auto;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #000000;
}

.tab-item.active .tab-label {
  color: #6155F5;
  font-weight: 700;
}
