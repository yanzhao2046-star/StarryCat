<view class="page" bindtap="onPageTap">
  <!-- ====== 上半区：头部 + 聊天消息 ====== -->
  <view class="chat-area">
    <view class="chat-header">
      <view class="header-title-row">
        <text class="header-title">星星猫宇宙</text>
        <view class="header-mycatter-btn" hover-class="header-mycatter-btn--hover" bindtap="onMyCatter">
          <text class="header-mycatter-text">我的猫</text>
        </view>
      </view>
      <text class="header-subtitle">聊心事，养猫</text>
    </view>

    <scroll-view
      class="chat-body"
      scroll-y
      scroll-into-view="{{scrollToView}}"
      scroll-with-animation
      enhanced
      show-scrollbar="{{false}}"
      id="chat-scroll"
    >
      <view class="chat-messages" wx:if="{{messages.length > 0}}">
        <block wx:for="{{messages}}" wx:key="id">
          <view class="msg-time" wx:if="{{item.showTime}}">{{item.timeText}}</view>
          <view class="msg-row msg-row--ai" wx:if="{{item.role === 'ai'}}">
          <image class="msg-avatar" src="/assets/3.png" mode="aspectFill"></image>
          <view class="msg-bubble msg-bubble--ai">{{item.content}}</view>
          </view>
          <view class="msg-row msg-row--user" wx:if="{{item.role === 'user'}}">
            <view class="msg-bubble msg-bubble--user">{{item.content}}</view>
            <image class="msg-avatar" src="/assets/moodAdd/{{item.avatar || '5'}}.png" mode="aspectFill"></image>
          </view>
        </block>
      </view>

      <view class="chat-empty" wx:if="{{messages.length === 0}}">
        <image class="empty-cat-img" src="/assets/3.png" mode="aspectFit"></image>
        <text class="empty-tip">和星星猫聊聊吧~</text>
      </view>

      <view class="msg-row msg-row--ai" wx:if="{{isTyping}}">
      <image class="msg-avatar" src="/assets/3.png" mode="aspectFill"></image>
      <view class="msg-bubble msg-bubble--ai msg-bubble--typing">
          <view class="typing-dot"></view>
          <view class="typing-dot"></view>
          <view class="typing-dot"></view>
        </view>
      </view>

      <view id="scroll-bottom" style="height:2rpx"></view>
    </scroll-view>
  </view>

  <!-- 输入区域 -->
  <view class="chat-input-bar">
    <input
      class="chat-input"
      value="{{inputText}}"
      placeholder="和猫猫说点什么..."
      placeholder-class="input-placeholder"
      confirm-type="send"
      bindinput="onInput"
      bindconfirm="onSend"
      adjust-position="{{true}}"
      maxlength="500"
    />
    <view class="chat-send-btn {{inputText ? 'chat-send-btn--active' : ''}}" bindtap="onSend" hover-class="chat-send-btn--hover">
      <text class="chat-send-text">发送</text>
    </view>
  </view>

  <!-- 底部导航栏（来自 youMeOther — inline flex + margin-top:auto） -->
  <view class="tab-bar">
    <view class="tab-item" data-tab="moodIsland" bindtap="onTabTap">
      <image class="tab-icon" src="/assets/moodLib/4.svg" mode="aspectFit"></image>
      <text class="tab-label">情绪岛</text>
    </view>
    <view class="tab-item" data-tab="moodLib" bindtap="onTabTap">
      <image class="tab-icon" src="/assets/moodLib/3.svg" mode="aspectFit"></image>
      <text class="tab-label">心情库</text>
    </view>
    <view class="tab-item active" data-tab="starTalk" bindtap="onTabTap">
      <image class="tab-icon" src="/assets/moodLib/2.svg" mode="aspectFit"></image>
      <text class="tab-label">星猫说</text>
    </view>
    <view class="tab-item" data-tab="people" bindtap="onTabTap">
      <image class="tab-icon" src="/assets/moodLib/1.svg" mode="aspectFit"></image>
      <text class="tab-label">你我他</text>
    </view>
  </view>
</view>
