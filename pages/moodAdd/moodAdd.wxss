/* ============================================
   moodAdd - 情绪岛 / 记录心情页
   Figma 基准: 375 × 852 px → 750 × 1704 rpx
   换算规则: 1 Figma px = 2 rpx
   全部 rpx，禁止 px
   ============================================ */

/* ---- 根元素 ---- */
page {
  background: #ffffff;
  height: 100vh;
}

/* ---- 外层容器 ---- */
.page {
  width: 100%;
  height: 100vh;
  position: relative;
  background: #ffffff;
}

/* ---- 滚��主体区域 ---- */
.page-body {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 60rpx;
  padding-bottom: calc(96rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ============================================
   顶部 — 日期 & 问候
   Figma: 171×161px, left:28, top:75
   → header padding-top: 150rpx (75px × 2)
   ============================================ */
.header {
  padding-top: 36rpx;
  flex-shrink: 0;
}

.header-date {
  font-size: 24rpx;
  font-weight: 500;
  color: #000000;
}

/* ---- 头像 + 问候语 横向排列 ---- */
.header-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 20rpx;
}

/* ---- 用户专属头像（onboard 选择，圆形裁剪） ---- */
.header-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}

/* ---- 问候语 ---- */
.header-greeting {
  font-size: 40rpx;
  font-weight: 700;
  color: #6155F5;
  line-height: 1.35;
  white-space: pre-line;
  margin-left: 24rpx;
}

/* ============================================
   主内容区域
   ============================================ */
.content {
  width: 100%;
  padding-top: 0;
}

/* ---- 此刻发生了什么 ---- */
.event-section {
  margin-top: 12rpx;
  margin-bottom: 12rpx;
}

.event-label {
  font-size: 24rpx;
  font-weight: 100;
  color: #000000;
  margin-bottom: 8rpx;
}

.event-input {
  width: 100%;
  height: 116rpx;
  background: #ffffff;
  border: 2rpx solid #000000;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #000000;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.ph {
  color: #9CA3AF;
}

/* ============================================
   长按心情蓄力 — 4列3行网格
   Figma: 317.20×313.54px
   每格约 68×84px → 136×168rpx
   ============================================ */
.mood-section {
  display: flex;
  flex-direction: column;
}

.mood-label {
  font-size: 24rpx;
  font-weight: 100;
  color: #000000;
  margin-bottom: 20rpx;
}

.mood-section {
  margin-top: 8rpx;
}

.mood-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18rpx 12rpx;
  width: 100%;
}

.mood-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  position: relative;
  padding-bottom: 18rpx;
}

/* ---- 边框圆形容器（Figma 51_5915 data-svg-wrapper） ---- */
.mood-icon-border {
  width: 136rpx;
  height: 136rpx;
  border-radius: 16rpx;
  border: 3rpx solid #D9D9D9;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
  overflow: hidden;
  transition: border-color 0.15s ease;
}

/* ---- 激活态：边框高亮 ---- */
.mood-cell--active .mood-icon-border {
  border-color: #6155F5;
}

/* ---- 激活态：图标轻微放大 ---- */
.mood-cell--active .mood-icon {
  transform: scale(1.12);
}

.mood-icon {
  width: 98rpx;
  height: 98rpx;
  transition: transform 0.15s ease;
}

.mood-name {
  font-size: 22rpx;
  font-weight: 400;
  color: #000000;
  margin-top: 10rpx;
  text-align: center;
  line-height: 1.3;
}

/* ============================================
   进度条 — 固定在图标正下方
   不挤压周边布局（position:absolute 相对 mood-cell）
   ============================================ */
.progress-bar {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 120rpx;
  height: 8rpx;
  background: #E5E7EB;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-bar__fill {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #F59E0B, #F97316, #EF4444);
  transition: width 0.05s linear;
  max-width: 100%;
}

/* ============================================
   能量反馈区 — 保存按钮上方
   ============================================ */
.energy-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  margin-top: 30rpx;
}

.energy-info__score {
  font-size: 28rpx;
  font-weight: 600;
  color: #6155F5;
}

/* ---- 操作按钮区（在scroll-view外部） ---- */
.action-bar {
  width: 100%;
  flex-shrink: 0;
  padding: 20rpx 0 30rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

/* ---- 心情DIY 按钮 ---- */
.diy-btn {
  width: 170rpx;
  height: 48rpx;
  background: rgba(97, 85, 245, 0.10);
  border-radius: 14rpx;
  border: none;
  font-size: 24rpx;
  font-weight: 700;
  color: #000000;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  align-self: center;
  padding: 0 12rpx;
  box-sizing: border-box;
  margin: 0 auto;
  transition: background 0.2s;
}

.diy-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.diy-hover {
  background: #F0EEFF;
}

/* ---- 保存按钮 ---- */
.save-btn {
  width: 390rpx;
  height: 70rpx;
  background: #6155F5;
  border-radius: 18rpx;
  border: 2rpx solid #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: center;
  padding: 0;
  box-sizing: border-box;
  line-height: 70rpx;
  margin: 30rpx auto 0 auto;
  transition: background 0.2s;
}

.save-hover {
  background: #4A40E0;
}

/* ============================================
   底部导航栏
   ============================================ */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: #ffffff;
  width: 100%;
  height: 96rpx;
  padding: 0 60rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #000000;
}

.tab-item.active .tab-label {
  color: #6155F5;
  font-weight: 700;
}
