<!-- ============================================
  moodAdd - 情绪岛 / 记录心情页
  Figma 基准: 375 × 852 px → 750 × 1704 rpx
  换算规则: 1 Figma px = 2 rpx
  ============================================ -->

<view class="page">

  <scroll-view class="page-body" scroll-y="true" enhanced="true" show-scrollbar="{{false}}">

  <!-- =================== 顶部日期 & 问候 =================== -->
  <view class="header">
    <view class="header-date">{{dateString}}</view>
    <view class="header-row">
      <!-- 用户专属头像（来自 onboard 选择，圆形裁剪） -->
      <image wx:if="{{userAvatar}}" class="header-avatar" src="{{userAvatar}}" mode="aspectFill"></image>
      <view class="header-greeting">{{greeting}}，{{nickname}}\n此刻的心情怎样</view>
    </view>
  </view>

  <!-- =================== 主内容区域（可滚动） =================== -->
  <view class="content">

    <!-- ---- 此刻发生了什么 ---- -->
    <view class="event-section">
      <view class="event-label">此刻发生了什么</view>
      <input
        class="event-input"
        placeholder="记录当下..."
        placeholder-class="ph"
        value="{{eventText}}"
        bindinput="onEventInput"
      />
    </view>

    <!-- ---- 长按心情蓄力 ---- -->
    <view class="mood-section">
      <view class="mood-label">长按心情蓄力</view>
      <view class="mood-grid">

        <!-- 行1 -->
        <view class="mood-cell {{pressingMood === '超开心' && showProgress ? 'mood-cell--active' : ''}}" data-mood="超开心" bindtouchstart="onMoodTouchStart" bindtouchend="onMoodTouchEnd" bindtouchcancel="onMoodTouchCancel">
          <view class="mood-icon-border"><image class="mood-icon" src="/assets/CodeBuddyAssets/1385_465/1.svg" mode="aspectFit"></image></view>
          <text class="mood-name">超开心</text>
          <view class="progress-bar" wx:if="{{pressingMood === '超开心' && showProgress}}"><view class="progress-bar__fill" style="width: {{progressPercent}}%;"></view></view>
        </view>

        <view class="mood-cell {{pressingMood === '偷偷小得意' && showProgress ? 'mood-cell--active' : ''}}" data-mood="偷偷小得意" bindtouchstart="onMoodTouchStart" bindtouchend="onMoodTouchEnd" bindtouchcancel="onMoodTouchCancel">
          <view class="mood-icon-border"><image class="mood-icon" src="/assets/CodeBuddyAssets/1385_465/2.svg" mode="aspectFit"></image></view>
          <text class="mood-name">偷偷小得意</text>
          <view class="progress-bar" wx:if="{{pressingMood === '偷偷小得意' && showProgress}}"><view class="progress-bar__fill" style="width: {{progressPercent}}%;"></view></view>
        </view>

        <view class="mood-cell {{pressingMood === '充满干劲' && showProgress ? 'mood-cell--active' : ''}}" data-mood="充满干劲" bindtouchstart="onMoodTouchStart" bindtouchend="onMoodTouchEnd" bindtouchcancel="onMoodTouchCancel">
          <view class="mood-icon-border"><image class="mood-icon" src="/assets/CodeBuddyAssets/1385_465/3.svg" mode="aspectFit"></image></view>
          <text class="mood-name">充满干劲</text>
          <view class="progress-bar" wx:if="{{pressingMood === '充满干劲' && showProgress}}"><view class="progress-bar__fill" style="width: {{progressPercent}}%;"></view></view>
        </view>

        <view class="mood-cell {{pressingMood === '有点迷糊' && showProgress ? 'mood-cell--active' : ''}}" data-mood="有点迷糊" bindtouchstart="onMoodTouchStart" bindtouchend="onMoodTouchEnd" bindtouchcancel="onMoodTouchCancel">
          <view class="mood-icon-border"><image class="mood-icon" src="/assets/CodeBuddyAssets/1385_465/4.svg" mode="aspectFit"></image></view>
          <text class="mood-name">有点迷糊</text>
          <view class="progress-bar" wx:if="{{pressingMood === '有点迷糊' && showProgress}}"><view class="progress-bar__fill" style="width: {{progressPercent}}%;"></view></view>
        </view>

        <!-- 行2 -->
        <view class="mood-cell {{pressingMood === '认真专注' && showProgress ? 'mood-cell--active' : ''}}" data-mood="认真专注" bindtouchstart="onMoodTouchStart" bindtouchend="onMoodTouchEnd" bindtouchcancel="onMoodTouchCancel">
          <view class="mood-icon-border"><image class="mood-icon" src="/assets/CodeBuddyAssets/1385_465/5.svg" mode="aspectFit"></image></view>
          <text class="mood-name">认真专注</text>
          <view class="progress-bar" wx:if="{{pressingMood === '认真专注' && showProgress}}"><view class="progress-bar__fill" style="width: {{progressPercent}}%;"></view></view>
        </view>

        <view class="mood-cell {{pressingMood === '有点沮丧' && showProgress ? 'mood-cell--active' : ''}}" data-mood="有点沮丧" bindtouchstart="onMoodTouchStart" bindtouchend="onMoodTouchEnd" bindtouchcancel="onMoodTouchCancel">
          <view class="mood-icon-border"><image class="mood-icon" src="/assets/CodeBuddyAssets/1385_465/6.svg" mode="aspectFit"></image></view>
          <text class="mood-name">有点沮丧</text>
          <view class="progress-bar" wx:if="{{pressingMood === '有点沮丧' && showProgress}}"><view class="progress-bar__fill" style="width: {{progressPercent}}%;"></view></view>
        </view>

        <view class="mood-cell {{pressingMood === '想歇一会' && showProgress ? 'mood-cell--active' : ''}}" data-mood="想歇一会" bindtouchstart="onMoodTouchStart" bindtouchend="onMoodTouchEnd" bindtouchcancel="onMoodTouchCancel">
          <view class="mood-icon-border"><image class="mood-icon" src="/assets/CodeBuddyAssets/1385_465/7.svg" mode="aspectFit"></image></view>
          <text class="mood-name">想歇一会</text>
          <view class="progress-bar" wx:if="{{pressingMood === '想歇一会' && showProgress}}"><view class="progress-bar__fill" style="width: {{progressPercent}}%;"></view></view>
        </view>

        <view class="mood-cell {{pressingMood === '烦躁生气' && showProgress ? 'mood-cell--active' : ''}}" data-mood="烦躁生气" bindtouchstart="onMoodTouchStart" bindtouchend="onMoodTouchEnd" bindtouchcancel="onMoodTouchCancel">
          <view class="mood-icon-border"><image class="mood-icon" src="/assets/CodeBuddyAssets/1385_465/8.svg" mode="aspectFit"></image></view>
          <text class="mood-name">烦躁生气</text>
          <view class="progress-bar" wx:if="{{pressingMood === '烦躁生气' && showProgress}}"><view class="progress-bar__fill" style="width: {{progressPercent}}%;"></view></view>
        </view>

        <!-- 行3 -->
        <view class="mood-cell {{pressingMood === '感恩' && showProgress ? 'mood-cell--active' : ''}}" data-mood="感恩" bindtouchstart="onMoodTouchStart" bindtouchend="onMoodTouchEnd" bindtouchcancel="onMoodTouchCancel">
          <view class="mood-icon-border"><image class="mood-icon" src="/assets/CodeBuddyAssets/1385_465/9.svg" mode="aspectFit"></image></view>
          <text class="mood-name">感恩</text>
          <view class="progress-bar" wx:if="{{pressingMood === '感恩' && showProgress}}"><view class="progress-bar__fill" style="width: {{progressPercent}}%;"></view></view>
        </view>

        <view class="mood-cell {{pressingMood === '热爱劳动' && showProgress ? 'mood-cell--active' : ''}}" data-mood="热爱劳动" bindtouchstart="onMoodTouchStart" bindtouchend="onMoodTouchEnd" bindtouchcancel="onMoodTouchCancel">
          <view class="mood-icon-border"><image class="mood-icon" src="/assets/CodeBuddyAssets/1385_465/10.svg" mode="aspectFit"></image></view>
          <text class="mood-name">热爱劳动</text>
          <view class="progress-bar" wx:if="{{pressingMood === '热爱劳动' && showProgress}}"><view class="progress-bar__fill" style="width: {{progressPercent}}%;"></view></view>
        </view>

        <view class="mood-cell {{pressingMood === '团队合作' && showProgress ? 'mood-cell--active' : ''}}" data-mood="团队合作" bindtouchstart="onMoodTouchStart" bindtouchend="onMoodTouchEnd" bindtouchcancel="onMoodTouchCancel">
          <view class="mood-icon-border"><image class="mood-icon" src="/assets/CodeBuddyAssets/1385_465/11.svg" mode="aspectFit"></image></view>
          <text class="mood-name">团队合作</text>
          <view class="progress-bar" wx:if="{{pressingMood === '团队合作' && showProgress}}"><view class="progress-bar__fill" style="width: {{progressPercent}}%;"></view></view>
        </view>

        <view class="mood-cell {{pressingMood === '平和放松' && showProgress ? 'mood-cell--active' : ''}}" data-mood="平和放松" bindtouchstart="onMoodTouchStart" bindtouchend="onMoodTouchEnd" bindtouchcancel="onMoodTouchCancel">
          <view class="mood-icon-border"><image class="mood-icon" src="/assets/CodeBuddyAssets/1385_465/12.svg" mode="aspectFit"></image></view>
          <text class="mood-name">平和放松</text>
          <view class="progress-bar" wx:if="{{pressingMood === '平和放松' && showProgress}}"><view class="progress-bar__fill" style="width: {{progressPercent}}%;"></view></view>
        </view>

      </view>
    </view>

    <!-- ---- 当前蓄力状态 ---- -->
    <view class="energy-info" wx:if="{{currentMoodType}}">
      <text class="energy-info__score">🔥 {{currentMoodType}} · {{moodEnergy}} 分</text>
    </view>

  <!-- ---- 操作按钮 ---- -->
  <view class="action-bar">
    <view class="diy-btn" bindtap="onDiyTap" hover-class="diy-hover">
      <image class="diy-icon" src="/assets/CodeBuddyAssets/313_336/1.svg" mode="aspectFit"></image>
      <text>心情DIY</text>
    </view>
    <view class="save-btn" bindtap="onSaveMood" hover-class="save-hover">保存心情</view>
  </view>

  </view>

  </scroll-view>

  <!-- =================== 底部导航栏（情绪岛激活） =================== -->
  <view class="tab-bar">
    <view class="tab-item active" data-tab="moodIsland" bindtap="onTabSwitch">
      <image class="tab-icon" src="/assets/moodLib/4.svg" mode="aspectFit"></image>
      <text class="tab-label">情绪岛</text>
    </view>
    <view class="tab-item" data-tab="moodLib" bindtap="onTabSwitch">
      <image class="tab-icon" src="/assets/moodLib/3.svg" mode="aspectFit"></image>
      <text class="tab-label">心情库</text>
    </view>
    <view class="tab-item" data-tab="starTalk" bindtap="onTabSwitch">
      <image class="tab-icon" src="/assets/moodLib/2.svg" mode="aspectFit"></image>
      <text class="tab-label">星猫说</text>
    </view>
    <view class="tab-item" data-tab="people" bindtap="onTabSwitch">
      <image class="tab-icon" src="/assets/moodLib/1.svg" mode="aspectFit"></image>
      <text class="tab-label">你我他</text>
    </view>
  </view>

</view>
