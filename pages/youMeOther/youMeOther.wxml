<!-- ============================================
  youMeOther - 心情你我他
  Figma 基准: 375 × 852 px → 750 × 1704 rpx
  Tab: 我的（本人分享的）+ 好友（好友火苗卡）
  ============================================ -->

<wxs module="moodIcon">
var icons = ['超开心','偷偷小得意','充满干劲','有点迷糊','认真专注',
             '有点沮丧','想歇一会','烦躁生气','感恩','热爱劳动',
             '团队合作','心情DIY'];
var pool = [5,7,9,11,13,15,17,20,5,7,9,11];
module.exports = function(mood) {
  var idx = icons.indexOf(mood);
  var num = pool[idx] || 5;
  var ext = '.svg';
  if (num === 5 || num === 7 || num === 11 || num === 17) {
    ext = '.png';
  }
  return '/assets/moodLib/' + num + ext;
}
</wxs>

<view class="page">

  <!-- =================== 顶部标题区 =================== -->
  <view class="header">
    <text class="header-title">心情你我他</text>
    <text class="header-subtitle">{{displayList.length}} 位好友</text>
  </view>

  <!-- =================== 标签栏：我的 / 好友 =================== -->
  <view class="tab-filters">
    <view
      class="filter-item {{filterTab === 'mine' ? 'filter-item--active' : ''}}"
      data-tab="mine"
      bindtap="onSwitchTab"
    >我的</view>
    <view
      class="filter-item {{filterTab === 'friend' ? 'filter-item--active' : ''}}"
      data-tab="friend"
      bindtap="onSwitchTab"
    >好友</view>
  </view>

  <!-- =================== 空状态 =================== -->
  <view class="empty-state" wx:if="{{displayList.length === 0}}">
    <image class="empty-icon" src="/assets/moodLib/20.svg" mode="aspectFit"></image>
    <text class="empty-text" wx:if="{{filterTab === 'mine'}}">还没有分享过心情</text>
    <text class="empty-sub" wx:if="{{filterTab === 'mine'}}">去心情库点击"分享至你我他"吧</text>
    <text class="empty-text" wx:if="{{filterTab === 'friend'}}">还没有好友分享心情</text>
    <text class="empty-sub" wx:if="{{filterTab === 'friend'}}">邀请好友一起互动吧</text>
  </view>

  <!-- =================== 动态列表 =================== -->
  <scroll-view class="feed-scroll" wx:if="{{displayList.length > 0}}" scroll-y show-scrollbar="{{false}}">

    <block wx:for="{{displayList}}" wx:key="id">

      <!-- ====== 紧凑卡片 ====== -->
      <view class="record-card {{expandedId === item.id ? 'record-card--expanded' : ''}}">
        <image class="rc-icon" src="{{moodIcon(item.emotionName)}}" mode="aspectFit"></image>

        <view class="rc-body">
          <text class="rc-mood">{{item.emotionName}}</text>
          <view class="rc-note">
            <text class="rc-note-txt">{{item.emotionSlang || '—'}}</text>
            <text class="rc-score">{{item.emotionScore}}</text>
          </view>
        </view>

        <view class="rc-btn" catchtap="onToggleExpand" data-id="{{item.id}}">
          <image class="rc-btn-icon" src="/assets/moodLib/6.svg" mode="aspectFit"></image>
        </view>
      </view>

      <!-- ====== 展开详情面板 ====== -->
      <view class="expand-panel" wx:if="{{expandedId === item.id}}">
        <view class="expand-inner">

          <!-- 时间 -->
          <text class="exp-time">{{item.time}}</text>

          <!-- 心情行 -->
          <view class="exp-mood-row">
            <image class="exp-mood-icon" src="{{moodIcon(item.emotionName)}}" mode="aspectFit"></image>
            <view class="exp-mood-body">
              <text class="exp-mood-name">{{item.emotionName}}</text>
              <view class="exp-mood-note-row">
                <text class="exp-mood-note">{{item.emotionSlang || '—'}}</text>
                <text class="exp-mood-score">{{item.emotionScore}}</text>
              </view>
            </view>
          </view>

          <!-- 语录 + 星猫建议 -->
          <view class="exp-quote" wx:if="{{item.selfNote || item.starCatAdvice}}">
            <text class="exp-quote-text" wx:if="{{item.selfNote}}">{{item.selfNote}}</text>
            <text class="exp-quote-text" wx:if="{{item.starCatAdvice}}">{{item.starCatAdvice}}</text>
          </view>

          <!-- 互动操作区（Figma: 极简行内布局） -->
          <view class="exp-actions">
            <!-- 点赞：图标 + 数字 -->
            <view class="act-item" catchtap="onLikeFeed" data-id="{{item.id}}">
              <image class="act-icon" src="/assets/CodeBuddyAssets/275_993/2.svg" mode="aspectFit"></image>
              <text class="act-count">{{item.likeCount || 0}}</text>
            </view>
            <!-- 情绪助力：图标 + 文字 + 助力数 -->
            <view class="act-item" catchtap="onBoostFeed" data-id="{{item.id}}">
              <image class="act-icon" src="/assets/CodeBuddyAssets/275_993/3.svg" mode="aspectFit"></image>
              <text class="act-label">情绪助力</text>
              <text class="act-count">{{item.boostCount || 0}}</text>
            </view>
          </view>

          <!-- 评论面板组件 -->
          <view class="exp-comments">
            <comment-panel
              list="{{item.commentList || []}}"
              targetMoodId="{{item.id}}"
              selfOpenId="{{selfOpenId}}"
              bind:sendComment="onSendComment"
            />
          </view>

        </view>
      </view>

    </block>

  </scroll-view>

  <!-- =================== 底部 Tab 栏（你我他高亮） =================== -->
  <view class="tab-bar">
    <view class="tab-item" data-tab="moodIsland" bindtap="onTabSwitch">
      <image class="tab-icon" src="/assets/moodLib/4.svg" mode="aspectFit"></image>
      <text class="tab-label">情绪岛</text>
    </view>
    <view class="tab-item" data-tab="moodLib" bindtap="onTabSwitch">
      <image class="tab-icon" src="/assets/moodLib/3.svg" mode="aspectFit"></image>
      <text class="tab-label">心情库</text>
    </view>
    <view class="tab-item" data-tab="starTalk" bindtap="onTabSwitch">
      <image class="tab-icon" src="/assets/moodLib/2.svg" mode="aspectFit"></image>
      <text class="tab-label">星猫说</text>
    </view>
    <view class="tab-item active" data-tab="people" bindtap="onTabSwitch">
      <image class="tab-icon" src="/assets/moodLib/1.svg" mode="aspectFit"></image>
      <text class="tab-label">你我他</text>
    </view>
  </view>

</view>
