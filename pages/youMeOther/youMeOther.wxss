/* ============================================
   youMeOther - 心情你我他
   与 moodLib 卡片风格统一
   Figma 基准: 375px → 1px = 2rpx
   ============================================ */

/* ---- 页面级 ---- */
page {
  background: #FFFFFF;
  height: 100vh;
}

.page {
  width: 100%;
  height: 100vh;
  position: relative;
  background: #FFFFFF;
}

.page-body {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 60rpx;
  padding-bottom: calc(96rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.scroll-list {
  width: 100%;
}

/* ============================================
   顶部标题区
   Figma: 渐变 #F9F4FF → white
   ============================================ */
.header {
  position: relative;
  width: 100%;
  margin-top: 24rpx;
  padding: 32rpx 30rpx;
  box-sizing: border-box;
  background: linear-gradient(160deg, #F9F4FF 0%, #FFFFFF 100%);
  border-radius: 40rpx 40rpx 0 0;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
}

.header-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #111827;
}

.header-subtitle {
  font-size: 26rpx;
  font-weight: 400;
  color: #99A1AF;
}

/* ============================================
   标签栏：我的 / 好友
   ============================================ */
.tab-filters {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 0 16rpx 0;
  gap: 48rpx;
}

.filter-item {
  font-size: 30rpx;
  font-weight: 700;
  color: #6B7280;
  position: relative;
  padding-bottom: 8rpx;
  transition: color 0.2s;
}

.filter-item--active {
  color: #111827;
}

.filter-item--active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 36rpx;
  height: 6rpx;
  background: #6155F5;
  border-radius: 3rpx;
}

/* ============================================
   空状态
   ============================================ */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding-bottom: 120rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #99A1AF;
}

.empty-sub {
  font-size: 24rpx;
  font-weight: 400;
  color: #C4CAD3;
}

/* ============================================
   动态列表（可滚动）
   ============================================ */
.feed-scroll {
  width: 100%;
  padding-top: 16rpx;
  box-sizing: border-box;
}

/* ---- 紧凑卡片（与 moodLib record-card 一致） ---- */
.record-card {
  width: 100%;
  min-height: 120rpx;
  background: #ffffff;
  border-radius: 40rpx;
  box-shadow: 0 0 40rpx rgba(0, 0, 0, 0.10);
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  margin-bottom: 18rpx;
  transition: box-shadow 0.2s;
}

.record-card--expanded {
  box-shadow: 0 0 48rpx rgba(97, 85, 245, 0.18);
}

/* ---- 左侧情绪图标 ---- */
.rc-icon {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
}

/* ---- 中间内容区 ---- */
.rc-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-left: 20rpx;
  overflow: hidden;
}

.rc-mood {
  font-size: 28rpx;
  font-weight: 650;
  color: #111827;
  line-height: 1.3;
}

.rc-note {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.rc-note-txt {
  font-size: 24rpx;
  font-weight: 400;
  color: #4D1A80;
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.rc-score {
  font-size: 21rpx;
  font-weight: 400;
  color: #000000;
  margin-left: 8rpx;
  flex-shrink: 0;
}

/* ---- 右侧展开按钮 ---- */
.rc-btn {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-left: 2rpx solid rgba(0, 0, 0, 0.10);
  margin-left: 20rpx;
  padding-left: 20rpx;
  flex-shrink: 0;
}

.rc-btn-icon {
  width: 48rpx;
  height: 48rpx;
}

/* ============================================
   展开详情面板（与 moodLib 一致）
   ============================================ */
.expand-panel {
  width: 100%;
  margin-bottom: 18rpx;
  animation: fadeSlideIn 0.25s ease;
}

@keyframes fadeSlideIn {
  from { opacity: 0; transform: translateY(-12rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.expand-inner {
  background: rgba(97, 85, 245, 0.05);
  border-radius: 44rpx;
  border: 2rpx solid #EDE9FE;
  padding: 24rpx;
  box-sizing: border-box;
}

.exp-time {
  font-size: 20rpx;
  font-weight: 290;
  color: #99A1AF;
  display: block;
  margin-bottom: 16rpx;
}

/* ---- 心情行 ---- */
.exp-mood-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.exp-mood-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}

.exp-mood-body {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.exp-mood-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.exp-mood-note-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 12rpx;
}

.exp-mood-note {
  font-size: 26rpx;
  font-weight: 400;
  color: #6155F5;
}

.exp-mood-score {
  font-size: 22rpx;
  font-weight: 500;
  color: #99A1AF;
}

/* ---- 语录 + 星猫建议 ---- */
.exp-quote {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 16rpx 0;
  margin-bottom: 12rpx;
  border-top: 1rpx solid rgba(97, 85, 245, 0.12);
  border-bottom: 1rpx solid rgba(97, 85, 245, 0.12);
}

.exp-quote-text {
  font-size: 24rpx;
  font-weight: 400;
  color: #374151;
  line-height: 1.6;
}

/* ---- 互动操作区（Figma: 极简行内） ---- */
.exp-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 28rpx;
  margin-top: 12rpx;
}

.act-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}

.act-icon {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
}

.act-label {
  font-size: 22rpx;
  font-weight: 700;
  font-family: Microsoft YaHei, sans-serif;
  color: #000000;
}

.act-count {
  font-size: 24rpx;
  font-weight: 700;
  font-family: Microsoft YaHei, sans-serif;
  color: #000000;
}

/* ---- 评论面板区域 ---- */
.exp-comments {
  margin-top: 24rpx;
}

/* ============================================
   底部导航栏
   ============================================ */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: #ffffff;
  width: 100%;
  height: 96rpx;
  padding: 0 60rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #000000;
}

.tab-item.active .tab-label {
  color: #6155F5;
  font-weight: 700;
}
