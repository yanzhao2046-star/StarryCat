/* ============================================================
   pages/catFood/catFood.wxss — 猫粮 (Figma 460_1279)
   顶部 + 食物卡片 + 碗 + 按钮 + 猫粮袋角标
   ============================================================ */

.page {
  min-height: 100vh;
  background: #FFFFFF;
  /* 让出悬浮导航胶囊的高度，避免内容被遮挡 */
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ========== 顶部 ========== */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  /* 与「猫的心情」页头部统一：上 36rpx · 下 16rpx */
  padding-top: 36rpx;
  padding-bottom: 16rpx;
}
.header-icon {
  width: 66rpx;            /* 与「猫的心情」图标同尺寸 */
  height: 66rpx;
}
.header-title {
  font-size: 28rpx;        /* 与「猫的心情」标题同规格 */
  font-weight: 400;
  color: #000000;
  margin-top: 4rpx;
  font-family: Inter, Microsoft YaHei, sans-serif;
}

/* ========== 食物卡片 ========== */
.food-card {
  margin: 16rpx 34rpx 24rpx;
  background: #FFF6F7;
  border-radius: 19rpx;
  padding: 20rpx 16rpx;
  box-sizing: border-box;
}

.food-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.food-cell {
  width: calc((100% - 24rpx) / 4);
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
  padding: 8rpx 4rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  transition: background 0.15s, opacity 0.15s;
}

.food-cell--hover {
  background: rgba(255, 217, 166, 0.4);
  opacity: 0.85;
}

/* 库存用完：整体置灰 */
.food-cell--out {
  opacity: 0.35;
}

.food-icon {
  width: 96rpx;
  height: 96rpx;
}

/* 克数行：分类小圆点 + 剩余克数 */
.food-line {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  margin-top: 6rpx;
}

.food-tier-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #CCCCCC;
}

.food-tier--meat .food-tier-dot { background: #E85D4C; }
.food-tier--veg .food-tier-dot { background: #6FA843; }
.food-tier--fruit .food-tier-dot { background: #E8A23D; }
.food-tier--vitamin .food-tier-dot { background: #7C3AED; }

.food-gram {
  font-size: 22rpx;
  color: #000000;
  font-family: Microsoft YaHei, sans-serif;
  font-weight: 200;
}

/* 配方提示 */
.recipe-hint {
  margin-top: 16rpx;
  text-align: center;
}

.recipe-hint-text {
  font-size: 18rpx;
  color: #B89B7A;
  font-family: Microsoft YaHei, sans-serif;
}

/* ========== 碗 ========== */
.bowl-area {
  position: relative;
  width: 343rpx;
  height: 343rpx;
  margin: 8rpx auto 8rpx;
}

.bowl-stack {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.bowl-piece {
  position: absolute;
  width: 80rpx;
  height: 80rpx;
  margin-left: -40rpx;
  margin-top: -40rpx;
  pointer-events: none;
  transition: left 0.25s, top 0.25s, transform 0.25s;
}

.bowl-piece-img {
  width: 100%;
  height: 100%;
}

.bowl-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none;
}

/* ========== 碗中信息 ========== */
.bowl-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 18rpx;
}

.bowl-info-line {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.bowl-info-label {
  font-size: 22rpx;
  color: #888888;
  font-family: Microsoft YaHei, sans-serif;
}

.bowl-info-gram {
  font-size: 44rpx;
  font-weight: 700;
  color: #8A5A2B;
  font-family: Microsoft YaHei, sans-serif;
  line-height: 1;
}

.bowl-info-unit {
  font-size: 22rpx;
  color: #8A5A2B;
  font-family: Microsoft YaHei, sans-serif;
}

.bowl-info-sub {
  font-size: 20rpx;
  color: #AAAAAA;
  margin-top: 6rpx;
  font-family: Microsoft YaHei, sans-serif;
}

/* ========== 生成猫粮按钮 ========== */
.feed-btn {
  margin: 0 auto;
  width: 296rpx;
  height: 68rpx;
  background: #FFFFFF;
  border: 2rpx solid #FFDBB3;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s;
}

.feed-btn--on {
  background: linear-gradient(180deg, #FFDBB3 0%, #FFC58F 100%);
  border-color: #8A5A2B;
}

.feed-btn--hover {
  opacity: 0.85;
}

.feed-btn-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #8A5A2B;
  font-family: Microsoft YaHei, sans-serif;
}

.feed-btn--on .feed-btn-text {
  color: #5C3A1B;
}

/* ========== 猫粮袋（Figma 490_1508） ========== */
/* 悬浮在底部导航胶囊之上，避免被遮挡 */
.bag {
  position: fixed;
  right: 24rpx;
  bottom: calc(168rpx + env(safe-area-inset-bottom));
  width: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 20;
  transition: opacity 0.15s;
}

.bag--hover {
  opacity: 0.86;
}

.bag-img {
  width: 132rpx;
  height: 150rpx;
  transition: filter 0.3s, opacity 0.3s, transform 0.3s;
}

/* —— 储量进度条 —— */
.bag-meter {
  width: 124rpx;
  height: 10rpx;
  margin-top: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 216, 220, 0.85);
  overflow: hidden;
}

.bag-meter-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #FFC58F 0%, #FF9AA8 100%);
  transition: width 0.35s ease;
}

/* —— 状态胶囊 —— */
.bag-pill {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.08);
}

.bag-pill-label,
.bag-pill-dot,
.bag-pill-gram {
  font-size: 20rpx;
  font-family: Microsoft YaHei, sans-serif;
  font-weight: 600;
  line-height: 1.2;
  color: #888888;
}

.bag-pill-dot {
  margin: 0 4rpx;
  font-weight: 400;
}

/* —— 四级状态 —— */
/* 0 空：灰掉 + 轻微摆动，提示猫咪在挨饿 */
.bag--0 .bag-img {
  filter: grayscale(1);
  opacity: 0.45;
  animation: bagSway 2.6s ease-in-out infinite;
}

/* 1 干瘪 */
.bag--1 .bag-img {
  filter: saturate(0.72);
  opacity: 0.82;
}

/* 2 半满：正常 */
.bag--2 .bag-img {
  opacity: 1;
}

/* 3 饱满：放大 + 粉光晕 */
.bag--3 .bag-img {
  opacity: 1;
  transform: scale(1.06);
  filter: drop-shadow(0 4rpx 12rpx rgba(255, 154, 168, 0.55));
}

.bag--0 .bag-pill-label,
.bag--0 .bag-pill-gram { color: #AAAAAA; }
.bag--1 .bag-pill-label,
.bag--1 .bag-pill-gram { color: #C6650F; }
.bag--2 .bag-pill-label,
.bag--2 .bag-pill-gram { color: #C97A2B; }
.bag--3 .bag-pill-label,
.bag--3 .bag-pill-gram { color: #D9526A; }

/* 合成出猫粮时：袋子弹一下 */
@keyframes bagPop {
  0%   { transform: scale(1); }
  40%  { transform: scale(1.18) translateY(-6rpx); }
  100% { transform: scale(1); }
}

@keyframes bagSway {
  0%, 100% { transform: rotate(-2deg); }
  50%      { transform: rotate(2deg); }
}

/* 动画只作用于 transform，结束后自动回到各状态自身的 transform */
.bag--pop .bag-img {
  animation: bagPop 0.5s ease;
}

/* ========== 返回 ========== */
.back-btn {
  position: fixed;
  left: 24rpx;
  top: 24rpx;
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.back-btn--hover {
  opacity: 0.8;
}

.back-btn-icon {
  font-size: 48rpx;
  color: #333;
  line-height: 1;
  margin-top: -6rpx;
}

/* ===== 底部导航：仅提供贴底定位，胶囊外观由 bottom-tab 组件自带 ===== */
.page-bottom-tab {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
}
