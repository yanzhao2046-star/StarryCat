/* ============================================
   moodCalendar - 心情日历页
   Figma 基准: 375 × 932 px → 750 × 1864 rpx
   1px = 2rpx
   ============================================ */

page {
  background: #ffffff;
  min-height: 100vh;
}

.page {
  width: 100%;
  min-height: 100vh;
  position: relative;
  background: #ffffff;
}

/* ---- 页面主体区域（原生滚动，Canvas 跟随无错位）---- */
.page-body {
  width: 100%;
  padding: 0 32rpx;
  padding-bottom: calc(96rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 滚动末端预留间距（图例下方呼吸空间） */
.page-bottom-spacer {
  height: 40rpx;
}

/* ============================================
   顶部区域 (0–157px → 0–314rpx)
   ============================================ */
.top-area {
  width: 100%;
  height: 314rpx;
  padding: 96rpx 8rpx 0 8rpx;
  box-sizing: border-box;
  background: #ffffff;
  flex-shrink: 0;
}

/* 日期小字 */
.ta-date {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: #000000;
  font-family: Inter, sans-serif;
  margin-bottom: 0;
  text-align: left;
}

/* 标题行：左侧标题 + 右侧按钮 */
.ta-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  width: 100%;
  margin-top: 0;
}

/* ---- 左侧标题区 ---- */
.ta-title-wrap {
  display: flex;
  flex-direction: column;
  width: 300rpx;
}

.ta-title {
  font-size: 40rpx;
  font-weight: 700;
  font-family: 'Microsoft YaHei', sans-serif;
  color: #101828;
  line-height: 1.4;
}

.ta-title-l2 {
  margin-top: 0;
}

.ta-sub {
  font-size: 28rpx;
  font-weight: 400;
  font-family: 'Microsoft YaHei', sans-serif;
  color: #99A1AF;
  margin-top: 4rpx;
}

/* ---- 右上角紫色按钮 ---- */
.ta-btn {
  width: 176rpx;
  height: 72rpx;
  background: #7C3AED;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 42rpx;
  flex-shrink: 0;
}

.ta-btn-text {
  font-size: 28rpx;
  font-weight: 400;
  font-family: 'Microsoft YaHei', sans-serif;
  color: #ffffff;
}

/* ============================================
   日历主体区域 (157px → 314rpx 起始)
   ============================================ */
.calendar-wrap {
  width: 100%;
  margin: 0 auto;
}

/* ---- 左右箭头 + 年月标题 ---- */
.cal-header {
  width: 100%;
  height: 46rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 26rpx;
}

.cal-arrow {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.cal-month {
  font-size: 38rpx;
  font-weight: 700;
  font-family: Inter, sans-serif;
  color: #4E3E44;
  margin: 0 100rpx;
  white-space: nowrap;
}
/* ---- 星期栏 ---- */
.cal-week {
  width: 100%;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 26rpx;
  padding: 0 2rpx;
  box-sizing: border-box;
}

.cw-item {
  font-size: 28rpx;
  font-weight: 600;
  font-family: Inter, sans-serif;
  color: #A89498;
  width: 98rpx;
  text-align: center;
}

/* ---- 日期格子 ---- */
.cal-grid {
  width: 652rpx;
  margin: 0 auto;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 14rpx;
}

.cal-cell {
  width: 81rpx;
  height: 81rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cal-cell-num {
  font-size: 28rpx;
  font-weight: 500;
  font-family: Inter, sans-serif;
  color: #4D1A80;
}

/* ============================================
   情绪轨迹图区域 (Figma: 355×590px → 710×1180rpx)
   ============================================ */
.track-section {
  width: 100%;
  margin: 120rpx auto 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

/* ---- 时间范围切换 tabs (Figma: 286×32px → 572×64rpx) ---- */
.ts-tabs {
  width: 572rpx;
  height: 64rpx;
  background: #F0EEF0;
  border-radius: 24rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.ts-tab {
  width: 122rpx;
  height: 52rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 2rpx;
  outline: 2rpx solid rgba(0, 0, 0, 0.22);
  outline-offset: -1rpx;
}

.ts-tab text {
  font-size: 28rpx;
  font-family: Microsoft YaHei, sans-serif;
  font-weight: 400;
  color: #000000;
}

.ts-tab--active {
  background: #FFFFFF;
}

/* ---- 月份标题 (Figma gap: 18px→36rpx) ---- */
.ts-month-header {
  width: 100%;
  height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 36rpx;
  gap: 14rpx;
}

.ts-arrow {
  width: 36rpx;
  height: 36rpx;
}

.ts-month-title {
  font-size: 38rpx;
  font-family: Microsoft YaHei, sans-serif;
  font-weight: 700;
  color: #4E3E44;
  line-height: 46rpx;
}

/* ---- 天数选择条 (Figma: 336×32px → 672×64rpx) ---- */
.ts-day-strip {
  width: 672rpx;
  height: 64rpx;
  margin-top: 36rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.ts-day-label {
  width: 67rpx;
  height: 52rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  outline: 2rpx solid rgba(0, 0, 0, 0.22);
  outline-offset: -1rpx;
}

.ts-day-label-text {
  font-size: 24rpx;
  font-family: Microsoft YaHei, sans-serif;
  font-weight: 400;
  color: #99A1AF;
}

.ts-day-cell {
  width: 67rpx;
  height: 52rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  outline: 2rpx solid rgba(0, 0, 0, 0.22);
  outline-offset: -1rpx;
}

.ts-day-cell--active {
  outline-color: rgba(0, 0, 0, 0.8);
}

.ts-day-num {
  font-size: 28rpx;
  font-family: Microsoft YaHei, sans-serif;
  font-weight: 400;
  color: #000000;
}

/* ---- 情绪能量变化图 (Figma: 332×329px → 664×658rpx) ---- */
.ts-chart-wrap {
  width: 664rpx;
  height: 658rpx;
  margin-top: 36rpx;
  position: relative;
}

/* Y轴标签 */
.ts-y-axis {
  position: absolute;
  left: 0;
  top: 10rpx;
  width: 34rpx;
  height: 618rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.ts-y-label {
  font-size: 24rpx;
  font-family: Microsoft YaHei, sans-serif;
  font-weight: 400;
  color: #99A1AF;
  text-align: right;
  width: 34rpx;
  height: 28rpx;
  line-height: 28rpx;
}

/* 图表核心区 */
.ts-chart-area {
  position: absolute;
  left: 46rpx;
  top: 10rpx;
  width: 618rpx;
  height: 618rpx;
  overflow: hidden;
}

/* 细网格背景 (16格×16格) */
.ts-grid-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image:
    repeating-linear-gradient(to right, #C7C7C7 0, #C7C7C7 1rpx, transparent 1rpx, transparent 38.625rpx),
    repeating-linear-gradient(to bottom, #C7C7C7 0, #C7C7C7 1rpx, transparent 1rpx, transparent 38.625rpx);
  z-index: 0;
}

/* 水平虚线参考线 */
.ts-dash-h {
  position: absolute;
  left: 0;
  width: 100%;
  height: 0;
  border-top: 1rpx dashed rgba(0, 0, 0, 0.2);
  z-index: 1;
}

/* 垂直虚线参考线 */
.ts-dash-v {
  position: absolute;
  top: 0;
  width: 0;
  height: 100%;
  border-left: 1rpx dashed rgba(0, 0, 0, 0.2);
  z-index: 1;
}

/* 图表实线边框 */
.ts-chart-border {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: 2rpx solid rgba(0, 0, 0, 0.5);
  box-sizing: border-box;
  z-index: 2;
  pointer-events: none;
}

/* Canvas 散点图 */
.scatter-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 618rpx;
  height: 618rpx;
  z-index: 3;
}

/* X轴标签 */
.ts-x-axis {
  position: absolute;
  left: 46rpx;
  bottom: 0;
  width: 618rpx;
  height: 28rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.ts-x-label {
  font-size: 20rpx;
  font-family: Microsoft YaHei, sans-serif;
  font-weight: 400;
  color: #99A1AF;
  width: 68rpx;
  text-align: center;
  line-height: 28rpx;
}

/* ---- 情绪类型图例 (Figma: 341×103px → 682×206rpx) ---- */
.ts-legend {
  width: 100%;
  margin-top: 36rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.ts-legend-row {
  display: flex;
  flex-direction: row;
  gap: 10rpx;
}

.ts-legend-tag {
  width: 160rpx;
  height: 56rpx;
  background: #F2F2F7;
  border-radius: 20rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 0 8rpx;
}

.ts-legend-icon {
  width: 20rpx;
  height: 20rpx;
  flex-shrink: 0;
}

.ts-legend-text {
  font-size: 20rpx;
  font-family: Microsoft YaHei, sans-serif;
  font-weight: 400;
  color: #101828;
  text-align: center;
  white-space: nowrap;
}

/* ============================================
   底部 Tab 导航栏（心情库高亮）
   ============================================ */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: #ffffff;
  width: 100%;
  height: 96rpx;
  padding: 0 60rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #000000;
}

.tab-item.active .tab-label {
  color: #6155F5;
  font-weight: 700;
}

/* ============================================
   星猫心情小发现弹窗（遮罩 + 卡片）
   Figma 卡片基准: 312 × 229 px → 624 × 458 rpx
   ============================================ */

/* ---- 半透明遮罩 ---- */
.report-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: rc-fadeIn 0.25s ease;
}

@keyframes rc-fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* ---- 卡片主体 ---- */
.report-card {
  width: 624rpx;
  background: #ECE6F0;
  border-radius: 56rpx;
  overflow: hidden;
  padding: 40rpx 32rpx 0 32rpx;
  box-sizing: border-box;
  animation: rc-scaleIn 0.3s ease;
}

@keyframes rc-scaleIn {
  from { transform: scale(0.9); opacity: 0; }
  to   { transform: scale(1); opacity: 1; }
}

/* ---- 头部：星猫 + 标题 ---- */
.rc-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
}

.rc-avatar-wrap {
  margin-bottom: 16rpx;
}

.rc-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7C3AED, #A78BFA);
  display: flex;
  align-items: center;
  justify-content: center;
}

.rc-avatar-text {
  font-size: 48rpx;
}

.rc-title {
  font-size: 36rpx;
  font-weight: 700;
  font-family: 'Microsoft YaHei', sans-serif;
  color: #101828;
  margin-bottom: 6rpx;
}

.rc-date {
  font-size: 22rpx;
  font-weight: 400;
  color: #99A1AF;
}

/* ---- 情绪色盘概览 ---- */
.rc-colors {
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 6rpx;
  margin-bottom: 28rpx;
}

.rc-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

/* ---- 情绪分布条 ---- */
.rc-bars {
  width: 100%;
  padding: 0 8rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.rc-bar-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 16rpx;
}

.rc-bar-label {
  width: 110rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #364153;
  flex-shrink: 0;
}

.rc-bar-track {
  flex: 1;
  height: 16rpx;
  border-radius: 8rpx;
  background: rgba(103, 80, 164, 0.12);
  overflow: hidden;
  margin: 0 16rpx;
}

.rc-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

.rc-bar-val {
  width: 60rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #364153;
  text-align: right;
  flex-shrink: 0;
}

/* ---- 星星猫洞察 ---- */
.rc-insight {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  background: rgba(103, 80, 164, 0.06);
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 28rpx;
}

.rc-insight-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.rc-insight-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.rc-insight-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #7C3AED;
  margin-bottom: 6rpx;
}

.rc-insight-text {
  font-size: 26rpx;
  font-weight: 400;
  color: #475569;
  line-height: 1.6;
}

/* ---- 分隔线 ---- */
.rc-divider {
  width: 100%;
  height: 2rpx;
  background: rgba(103, 80, 164, 0.12);
  margin-bottom: 20rpx;
}

/* ---- 底部反馈区（严格对齐 Figma） ---- */
/* Figma: 312×88px 区域 → 624×176rpx */
.rc-feedback {
  width: 624rpx;
  margin: 0 -32rpx 0 -32rpx;
  height: 176rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx;
  box-sizing: border-box;
  border-top: 2rpx solid rgba(103, 80, 164, 0.08);
}

.rc-fb-label {
  font-size: 24rpx;
  font-weight: 400;
  color: #99A1AF;
}

.rc-fb-btns {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

/* Figma 按钮: 61×40px 75×40px → 122×80rpx 150×80rpx */
.rc-fb-btn {
  height: 80rpx;
  padding: 0 32rpx;
  border-radius: 100rpx;
  border: 2rpx solid #6750A4;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.rc-fb-btn-text {
  font-size: 28rpx;
  font-weight: 500;
  font-family: Roboto, sans-serif;
  color: #6750A4;
  letter-spacing: 0.2rpx;
}

/* 激活态 */
.rc-fb-btn--active {
  background: #6750A4;
}

.rc-fb-btn--active .rc-fb-btn-text {
  color: #ffffff;
}

/* ============================================
   Canvas 散点图 点击浮层
   ============================================ */
.dot-tooltip-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 200;
}

.dot-tooltip-card {
  position: absolute;
  background: rgba(30, 30, 30, 0.92);
  border-radius: 16rpx;
  border-left: 8rpx solid;
  padding: 18rpx 24rpx;
  min-width: 180rpx;
  max-width: 320rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
  transform: translate(-50%, -100%);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  animation: tt-fadeIn 0.2s ease;
}

@keyframes tt-fadeIn {
  from { opacity: 0; transform: translate(-50%, -100%) scale(0.9); }
  to   { opacity: 1; transform: translate(-50%, -100%) scale(1); }
}

.dot-tooltip-emoji text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
}

.dot-tooltip-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.dot-tooltip-energy {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
}

.dot-tooltip-time {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.55);
}

.dot-tooltip-event {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  line-height: 1.4;
}
