/* ============================================
   moodCalendar - 心情日历页
   Figma 基准: 375 × 932 px → 750 × 1864 rpx
   1px = 2rpx
   ============================================ */

page {
  background: #ffffff;
  min-height: 100vh;
}

.page {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: #ffffff;
}

/* ============================================
   顶部区域 (0–157px → 0–314rpx)
   ============================================ */
.top-area {
  width: 750rpx;
  height: 314rpx;
  padding: 96rpx 40rpx 0 40rpx;
  box-sizing: border-box;
  background: #ffffff;
  flex-shrink: 0;
}

/* 日期小字 */
.ta-date {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: #000000;
  font-family: Inter, sans-serif;
  margin-bottom: 0;
  text-align: left;
}

/* 标题行：左侧标题 + 右侧按钮 */
.ta-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  width: 100%;
  margin-top: 0;
}

/* ---- 左侧标题区 ---- */
.ta-title-wrap {
  display: flex;
  flex-direction: column;
  width: 300rpx;
}

.ta-title {
  font-size: 40rpx;
  font-weight: 700;
  font-family: 'Microsoft YaHei', sans-serif;
  color: #101828;
  line-height: 1.4;
}

.ta-title-l2 {
  margin-top: 0;
}

.ta-sub {
  font-size: 28rpx;
  font-weight: 400;
  font-family: 'Microsoft YaHei', sans-serif;
  color: #99A1AF;
  margin-top: 4rpx;
}

/* ---- 右上角紫色按钮 ---- */
.ta-btn {
  width: 176rpx;
  height: 72rpx;
  background: #7C3AED;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 42rpx;
  flex-shrink: 0;
}

.ta-btn-text {
  font-size: 28rpx;
  font-weight: 400;
  font-family: 'Microsoft YaHei', sans-serif;
  color: #ffffff;
}

/* ============================================
   日历主体区域 (157px → 314rpx 起始)
   ============================================ */
.calendar-wrap {
  width: 686rpx;
  margin: 0 auto;
  flex-shrink: 0;
}

/* ---- 左右箭头 + 年月标题 ---- */
.cal-header {
  width: 100%;
  height: 46rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 26rpx;
}

.cal-arrow {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.cal-month {
  font-size: 38rpx;
  font-weight: 700;
  font-family: Inter, sans-serif;
  color: #4E3E44;
  margin: 0 100rpx;
  white-space: nowrap;
}

/* ---- 星期栏 ---- */
.cal-week {
  width: 100%;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 26rpx;
  padding: 0 2rpx;
  box-sizing: border-box;
}

.cw-item {
  font-size: 28rpx;
  font-weight: 600;
  font-family: Inter, sans-serif;
  color: #A89498;
  width: 98rpx;
  text-align: center;
}

/* ---- 日期格子 ---- */
.cal-grid {
  width: 652rpx;
  margin: 0 auto;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 14rpx;
}

.cal-cell {
  width: 81rpx;
  height: 81rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cal-cell-num {
  font-size: 28rpx;
  font-weight: 500;
  font-family: Inter, sans-serif;
  color: #4D1A80;
}

/* ============================================
   情绪报告区
   ============================================ */
.report-section {
  width: 656rpx;
  margin: 38rpx auto 0;
  flex-shrink: 0;
  padding-bottom: 40rpx;
}

.rs-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  font-family: 'Microsoft YaHei', sans-serif;
  color: #364153;
  line-height: 1.6;
}

.rs-desc {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  font-family: 'Microsoft YaHei', sans-serif;
  color: #364153;
  line-height: 1.6;
}

/* ---- 渐变色轮 ---- */
.rs-wheel {
  width: 526rpx;
  height: 556rpx;
  margin: 148rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
}

.rs-wheel-img {
  width: 596rpx;
  height: 596rpx;
  border-radius: 9999rpx;
}

/* ============================================
   底部 Tab 导航栏（心情库高亮）
   ============================================ */
.tab-bar {
  width: 670rpx;
  height: 96rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
  margin: auto auto 0 auto;
  padding-bottom: env(safe-area-inset-bottom);
  flex-shrink: 0;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-label {
  font-size: 24rpx;
  font-weight: 500;
  font-family: Inter, sans-serif;
  color: #000000;
}

.tab-item.active .tab-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #6155F5;
}

/* ============================================
   星猫心情小发现弹窗（遮罩 + 卡片）
   Figma 卡片基准: 312 × 229 px → 624 × 458 rpx
   ============================================ */

/* ---- 半透明遮罩 ---- */
.report-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: rc-fadeIn 0.25s ease;
}

@keyframes rc-fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* ---- 卡片主体 ---- */
.report-card {
  width: 624rpx;
  background: #ECE6F0;
  border-radius: 56rpx;
  overflow: hidden;
  padding: 40rpx 32rpx 0 32rpx;
  box-sizing: border-box;
  animation: rc-scaleIn 0.3s ease;
}

@keyframes rc-scaleIn {
  from { transform: scale(0.9); opacity: 0; }
  to   { transform: scale(1); opacity: 1; }
}

/* ---- 头部：星猫 + 标题 ---- */
.rc-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
}

.rc-avatar-wrap {
  margin-bottom: 16rpx;
}

.rc-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7C3AED, #A78BFA);
  display: flex;
  align-items: center;
  justify-content: center;
}

.rc-avatar-text {
  font-size: 48rpx;
}

.rc-title {
  font-size: 36rpx;
  font-weight: 700;
  font-family: 'Microsoft YaHei', sans-serif;
  color: #101828;
  margin-bottom: 6rpx;
}

.rc-date {
  font-size: 22rpx;
  font-weight: 400;
  color: #99A1AF;
}

/* ---- 情绪色盘概览 ---- */
.rc-colors {
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 6rpx;
  margin-bottom: 28rpx;
}

.rc-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

/* ---- 情绪分布条 ---- */
.rc-bars {
  width: 100%;
  padding: 0 8rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.rc-bar-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 16rpx;
}

.rc-bar-label {
  width: 110rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #364153;
  flex-shrink: 0;
}

.rc-bar-track {
  flex: 1;
  height: 16rpx;
  border-radius: 8rpx;
  background: rgba(103, 80, 164, 0.12);
  overflow: hidden;
  margin: 0 16rpx;
}

.rc-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

.rc-bar-val {
  width: 60rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #364153;
  text-align: right;
  flex-shrink: 0;
}

/* ---- 星星猫洞察 ---- */
.rc-insight {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  background: rgba(103, 80, 164, 0.06);
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 28rpx;
}

.rc-insight-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.rc-insight-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.rc-insight-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #7C3AED;
  margin-bottom: 6rpx;
}

.rc-insight-text {
  font-size: 26rpx;
  font-weight: 400;
  color: #475569;
  line-height: 1.6;
}

/* ---- 分隔线 ---- */
.rc-divider {
  width: 100%;
  height: 2rpx;
  background: rgba(103, 80, 164, 0.12);
  margin-bottom: 20rpx;
}

/* ---- 底部反馈区（严格对齐 Figma） ---- */
/* Figma: 312×88px 区域 → 624×176rpx */
.rc-feedback {
  width: 624rpx;
  margin: 0 -32rpx 0 -32rpx;
  height: 176rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx;
  box-sizing: border-box;
  border-top: 2rpx solid rgba(103, 80, 164, 0.08);
}

.rc-fb-label {
  font-size: 24rpx;
  font-weight: 400;
  color: #99A1AF;
}

.rc-fb-btns {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

/* Figma 按钮: 61×40px 75×40px → 122×80rpx 150×80rpx */
.rc-fb-btn {
  height: 80rpx;
  padding: 0 32rpx;
  border-radius: 100rpx;
  border: 2rpx solid #6750A4;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.rc-fb-btn-text {
  font-size: 28rpx;
  font-weight: 500;
  font-family: Roboto, sans-serif;
  color: #6750A4;
  letter-spacing: 0.2rpx;
}

/* 激活态 */
.rc-fb-btn--active {
  background: #6750A4;
}

.rc-fb-btn--active .rc-fb-btn-text {
  color: #ffffff;
}
