<!-- ============================================
  moodCalendar - 心情日历页（纯静态 UI）
  Figma 基准: 375 × 932 px → 750 × 1864 rpx
  1px = 2rpx
  ============================================ -->

<!-- 31 天紫色色阶映射 WXS -->
<wxs module="dayBg">
  var list = [
    '#EDDEFF','#DEC7FA','#CCB2F5','#BA99ED','#D9BFFF','#C7A6F2','#E5D1FA',
    '#D1B8F0','#E0CCFF','#BFA1EB','#EBD9FC','#B28CE5','#C79CF2','#D4BAF7',
    '#C4ABED','#DBC4F5','#E8D6FC','#BD94E8','#E3D1F7','#CFB0F2','#F0E0FF',
    '#C29EE5','#D6BDF5','#965ED7','#EDDEFF','#7A3AC9','#CCB2F5','#BA99ED',
    '#EDDEFF','#CCB2F5','#BD94E8'
  ];
  module.exports = function(day) {
    return list[day - 1] || '#EDDEFF';
  };
</wxs>

<view class="page">

  <!-- =================== 顶部区域 =================== -->
  <view class="top-area">
    <text class="ta-date">2026年07月25日</text>

    <view class="ta-row">
      <!-- 标题 + 小字 -->
      <view class="ta-title-wrap">
        <text class="ta-title">早上好，Cyne，</text>
        <text class="ta-title ta-title-l2">这里是你的情绪日历</text>
        <text class="ta-sub">最近 7 天</text>
      </view>

      <!-- 右上角紫色按钮【心情小发现】 -->
      <view class="ta-btn" bindtap="onReportTap">
        <text class="ta-btn-text">心情小发现</text>
      </view>
    </view>
  </view>

  <!-- =================== 日历区域 =================== -->
  <view class="calendar-wrap">

    <!-- ---- 日历头部：左右箭头 + 年月标题 ---- -->
    <view class="cal-header">
      <image class="cal-arrow" src="/assets/CodeBuddyAssets/269_322/5.svg" mode="aspectFit" bindtap="onPrevMonth"></image>
      <text class="cal-month">2026年 7月</text>
      <image class="cal-arrow" src="/assets/CodeBuddyAssets/269_322/6.svg" mode="aspectFit" bindtap="onNextMonth"></image>
    </view>

    <!-- ---- 星期栏 ---- -->
    <view class="cal-week">
      <text class="cw-item">Sun</text>
      <text class="cw-item">Mon</text>
      <text class="cw-item">Tue</text>
      <text class="cw-item">Wed</text>
      <text class="cw-item">Thu</text>
      <text class="cw-item">Fri</text>
      <text class="cw-item">Sat</text>
    </view>

    <!-- ---- 日期格子（31天假数据） ---- -->
    <view class="cal-grid">
      <view
        wx:for="{{days}}"
        wx:key="*this"
        class="cal-cell"
        style="background: {{dayBg(item)}};"
        data-day="{{item}}"
        bindtap="onDayTap"
      >
        <text class="cal-cell-num">{{item}}</text>
      </view>
    </view>

  </view>

  <!-- =================== 情绪报告区 =================== -->
  <view class="report-section">
    <text class="rs-title">情绪报告</text>
    <text class="rs-desc">情绪数据越多，情绪色盘越丰富</text>

    <!-- 渐变色轮预览图 -->
    <view class="rs-wheel">
      <image class="rs-wheel-img" src="/assets/CodeBuddyAssets/269_322/7.png" mode="aspectFit"></image>
    </view>
  </view>

  <!-- =================== 星猫心情报告弹窗 =================== -->
  <view class="report-overlay" wx:if="{{showReport}}" bindtap="onCloseReport">
    <view class="report-card" catchtap>

      <!-- 头部：星猫头像 + 标题 -->
      <view class="rc-header">
        <view class="rc-avatar-wrap">
          <!-- 星猫头像占位圆 -->
          <view class="rc-avatar">
            <text class="rc-avatar-text">🐱</text>
          </view>
        </view>
        <text class="rc-title">星猫心情小发现</text>
        <text class="rc-date">2026年07月 · 最近7天</text>
      </view>

      <!-- 情绪色盘概览 -->
      <view class="rc-colors">
        <view
          class="rc-dot"
          wx:for="{{reportColors}}"
          wx:key="*this"
          style="background: {{item}};"
        ></view>
      </view>

      <!-- 情绪分布条 -->
      <view class="rc-bars">
        <view class="rc-bar-row">
          <view class="rc-bar-label">😊 开心</view>
          <view class="rc-bar-track">
            <view class="rc-bar-fill" style="width: {{reportHappy}}%; background: linear-gradient(90deg, #C4B5FD, #7C3AED);"></view>
          </view>
          <text class="rc-bar-val">{{reportHappy}}%</text>
        </view>
        <view class="rc-bar-row">
          <view class="rc-bar-label">😌 平和</view>
          <view class="rc-bar-track">
            <view class="rc-bar-fill" style="width: {{reportCalm}}%; background: linear-gradient(90deg, #A5F3FC, #06B6D4);"></view>
          </view>
          <text class="rc-bar-val">{{reportCalm}}%</text>
        </view>
        <view class="rc-bar-row">
          <view class="rc-bar-label">😤 生气</view>
          <view class="rc-bar-track">
            <view class="rc-bar-fill" style="width: {{reportAngry}}%; background: linear-gradient(90deg, #FDE68A, #F59E0B);"></view>
          </view>
          <text class="rc-bar-val">{{reportAngry}}%</text>
        </view>
      </view>

      <!-- 星星猫洞察建议 -->
      <view class="rc-insight">
        <view class="rc-insight-icon">🌟</view>
        <view class="rc-insight-body">
          <text class="rc-insight-label">星星猫说</text>
          <text class="rc-insight-text">{{reportInsight}}</text>
        </view>
      </view>

      <!-- 分隔线 -->
      <view class="rc-divider"></view>

      <!-- 底部反馈按钮（严格对齐 Figma） -->
      <view class="rc-feedback">
        <text class="rc-fb-label">这份报告对你有帮助吗？</text>
        <view class="rc-fb-btns">
          <view class="rc-fb-btn {{reportFeedback === 'agree' ? 'rc-fb-btn--active' : ''}}" catchtap="onReportAgree">
            <text class="rc-fb-btn-text">同意</text>
          </view>
          <view class="rc-fb-btn {{reportFeedback === 'disagree' ? 'rc-fb-btn--active' : ''}}" catchtap="onReportDisagree">
            <text class="rc-fb-btn-text">不同意</text>
          </view>
        </view>
      </view>

    </view>
  </view>

  <!-- =================== 底部 Tab 栏（心情库高亮） =================== -->
  <view class="tab-bar">
    <view class="tab-item" data-tab="moodIsland" bindtap="onTabSwitch">
      <image class="tab-icon" src="/assets/CodeBuddyAssets/269_322/4.svg" mode="aspectFit"></image>
      <text class="tab-label">情绪岛</text>
    </view>
    <view class="tab-item active" data-tab="moodLib" bindtap="onTabSwitch">
      <image class="tab-icon" src="/assets/CodeBuddyAssets/269_322/3.svg" mode="aspectFit"></image>
      <text class="tab-label">心情库</text>
    </view>
    <view class="tab-item" data-tab="starTalk" bindtap="onTabSwitch">
      <image class="tab-icon" src="/assets/CodeBuddyAssets/269_322/2.svg" mode="aspectFit"></image>
      <text class="tab-label">星猫说</text>
    </view>
    <view class="tab-item" data-tab="people" bindtap="onTabSwitch">
      <image class="tab-icon" src="/assets/CodeBuddyAssets/269_322/1.svg" mode="aspectFit"></image>
      <text class="tab-label">你我他</text>
    </view>
  </view>

</view>
