/* ============================================================
   catAdopt - 选择你的猫（Figma 523_427）
   画布 402×874；1px ≈ 1.866rpx（375 屏宽换算）
   配色
     预览区背景   #FAF6F0
     描述条      #EFEAE2
     猫框边      #FFDBB3
     选中        #FFDB01
   ============================================================ */

page {
  background: #ffffff;
}

.page {
  width: 100%;
  min-height: 100vh;
  padding: 40rpx 0 80rpx;
  box-sizing: border-box;
}

.section {
  width: 710rpx;
  margin: 0 auto;
}

.section + .section {
  margin-top: 90rpx;
}

/* ------ 区块标题（图标 + 文字）------ */
.section-title {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}

.section-title .title-icon {
  width: 90rpx;
  height: 90rpx;
}

.section-title .title-text {
  font-size: 28rpx;
  color: #000000;
  margin-top: 16rpx;
}

.section-shoot .section-title {
  height: 166rpx;
}

.section-adopt .section-title {
  height: 162rpx;
}

/* ------ 拍摄：预览区 ------ */
.preview {
  width: 709rpx;
  height: 560rpx;
  background: #FAF6F0;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.preview-placeholder {
  font-size: 67rpx;
  font-weight: 400;
  color: #000000;
  text-align: center;
  line-height: 1.3;
  white-space: pre-wrap;
}

/* ------ 描述条：icon + 文字 + 灰色长条 ------ */
.desc {
  position: relative;
  height: 99rpx;
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.desc-icon {
  position: absolute;
  left: 124rpx;
  top: 0;
  width: 28rpx;
  height: 28rpx;
  z-index: 1;
}

.desc-bar {
  width: 709rpx;
  height: 54rpx;
  background: #EFEAE2;
  border-radius: 13rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.desc-text {
  font-size: 22rpx;
  font-weight: 300;
  color: #000000;
  padding-left: 60rpx;
}

/* ------ 领养：3×2 网格 ------ */
.cat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28rpx;
  margin-top: 8rpx;
}

.cat-cell {
  width: 100%;
  aspect-ratio: 1 / 1;
  border: 2rpx solid #FFDBB3;
  border-radius: 17rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  transition: transform 120ms ease, border-color 120ms ease, background-color 120ms ease;
}

.cat-cell:active {
  transform: scale(0.96);
}

.cat-cell.selected {
  border-color: #FFDB01;
  background: #FFFBEA;
}

.cat-thumb {
  width: 78%;
  height: 78%;
}

/* ============================================================
   ③ 取名 · 认养弹层
   ============================================================ */
.name-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  opacity: 0;
  visibility: hidden;
  transition: opacity 220ms ease, visibility 220ms ease;
  z-index: 100;
}

.name-mask--show {
  opacity: 1;
  visibility: visible;
}

.name-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 56rpx 48rpx calc(56rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: translateY(100%);
  transition: transform 260ms cubic-bezier(0.22, 0.61, 0.36, 1);
}

.name-mask--show .name-sheet {
  transform: translateY(0);
}

.name-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #000000;
}

.name-sub {
  margin-top: 12rpx;
  font-size: 22rpx;
  font-weight: 300;
  color: #9a8f82;
}

/* 猫预览 */
.name-preview {
  width: 220rpx;
  height: 220rpx;
  margin-top: 40rpx;
  border: 2rpx solid #FFDBB3;
  border-radius: 24rpx;
  background: #FFFDF8;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.name-preview-img {
  width: 82%;
  height: 82%;
}

/* 输入框（宽度对齐猫预览，略宽一点） */
.name-input {
  width: 340rpx;
  height: 96rpx;
  margin-top: 44rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #EFEAE2;
  border-radius: 20rpx;
  font-size: 30rpx;
  color: #000000;
  text-align: center;
}

.name-placeholder {
  color: #b3a89a;
  font-size: 26rpx;
  font-weight: 300;
}

/* 认养按钮 */
.name-btn {
  width: 340rpx;
  height: 96rpx;
  margin-top: 32rpx;
  border-radius: 48rpx;
  background: #FFDB01;
  color: #000000;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 120ms ease, transform 120ms ease;
}

.name-btn:active {
  transform: scale(0.98);
}

.name-btn--disabled {
  background: #F0EBE3;
  color: #b3a89a;
}

/* ============================================================
   ④ AI 生成中全屏遮罩
   ============================================================ */
.gen-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  opacity: 0;
  visibility: hidden;
  transition: opacity 220ms ease, visibility 220ms ease;
}

.gen-mask--show {
  opacity: 1;
  visibility: visible;
}

.gen-card {
  width: 460rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 56rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.gen-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #EFEAE2;
  border-top-color: #FFDB01;
  border-radius: 50%;
  animation: gen-spin 0.9s linear infinite;
}

@keyframes gen-spin {
  to { transform: rotate(360deg); }
}

.gen-title {
  margin-top: 32rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #000000;
}

.gen-sub {
  margin-top: 12rpx;
  font-size: 22rpx;
  font-weight: 300;
  color: #9a8f82;
  min-height: 30rpx;
}

.gen-bar {
  margin-top: 32rpx;
  width: 100%;
  height: 8rpx;
  background: #EFEAE2;
  border-radius: 4rpx;
  overflow: hidden;
}

.gen-bar-fill {
  height: 100%;
  background: #FFDB01;
  transition: width 240ms ease;
}