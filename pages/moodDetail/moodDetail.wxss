/* ============================================
   moodDetail - 心情库 / 记录展开详情页
   Figma: 375×852 → rpx (1px = 2rpx)
   ============================================ */

page {
  background: #ffffff;
  min-height: 100vh;
}

.page {
  width: 100%;
  box-sizing: border-box;
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #ffffff;
}

/* ============================================
   顶部标题 + 统计
   Figma: 384×203px, shadow bottom
   ============================================ */
.header {
  width: 100%;
  padding-top: 36rpx;
  flex-shrink: 0;
  box-shadow: 0 2rpx 0 #F3F4F6;
  padding-bottom: 32rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #101828;
}

.header-subtitle {
  font-size: 28rpx;
  font-weight: 400;
  color: #99A1AF;
  margin-top: 0;
}

/* 统计卡片行 */
.stats-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: 0;
}

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 138rpx;
  border-radius: 32rpx;
  gap: 0;
}

.stat-purple { background: #F5F3FF; }
.stat-blue   { background: #F0F9FF; }
.stat-green  { background: #ECFDF5; }

.stat-label {
  font-size: 20rpx;
  font-weight: 400;
  color: #99A1AF;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #000000;
}

.stat-p { color: #7C3AED; }
.stat-g { color: #009966; }

/* ============================================
   已选中记录卡片
   Figma: 335×60px, shadow, radius 20px
   ============================================ */
.selected-card {
  width: 100%;
  height: 120rpx;
  background: #ffffff;
  border-radius: 40rpx;
  box-shadow: 0 0 40rpx rgba(0, 0, 0, 0.10);
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
  margin-top: -10rpx;
  flex-shrink: 0;
}

.sc-left {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  overflow: hidden;
}

.sc-icon {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
}

.sc-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-left: 20rpx;
  overflow: hidden;
}

.sc-mood {
  font-size: 24rpx;
  font-weight: 400;
  color: #000000;
}

.sc-note-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.sc-note {
  font-size: 24rpx;
  font-weight: 400;
  color: #4D1A80;
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sc-score {
  font-size: 21rpx;
  font-weight: 400;
  color: #000000;
  margin-left: 8rpx;
  flex-shrink: 0;
}

.sc-right {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-left: 2rpx solid rgba(0, 0, 0, 0.10);
  margin-left: 20rpx;
  padding-left: 20rpx;
  flex-shrink: 0;
}

.sc-stats-icon {
  width: 48rpx;
  height: 48rpx;
}

/* ============================================
   展开详情面板
   Figma: 334×168px, outer border, inner bg
   ============================================ */
.detail-panel {
  width: 100%;
  margin-top: 16rpx;
  border-radius: 48rpx;
  border: 2rpx solid #F0EEF0;
  padding: 14rpx 10rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.detail-inner {
  width: 100%;
  background: rgba(97, 85, 245, 0.10);
  border-radius: 44rpx;
  padding: 10rpx 16rpx 26rpx 16rpx;
  box-sizing: border-box;
}

/* 日期 */
.detail-date {
  font-size: 20rpx;
  font-weight: 290;
  color: #101828;
}

/* 心情行 */
.detail-mood-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 32rpx;
  height: 80rpx;
}

.detail-mood-icon {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
}

.detail-mood-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-left: 20rpx;
  overflow: hidden;
}

.detail-mood-name {
  font-size: 24rpx;
  font-weight: 400;
  color: #000000;
}

.detail-mood-note-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.detail-mood-note {
  font-size: 24rpx;
  font-weight: 400;
  color: #4D1A80;
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.detail-mood-score {
  font-size: 21rpx;
  font-weight: 400;
  color: #000000;
  margin-left: 8rpx;
  flex-shrink: 0;
}

/* 语录区 */
.detail-quote {
  margin-top: 14rpx;
}

.detail-quote-text {
  font-size: 24rpx;
  font-weight: 400;
  color: #4A5565;
  line-height: 1.6;
  display: block;
}

/* 操作按钮区 */
.detail-actions {
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 80rpx;
  margin-top: 16rpx;
}

.btn-detail {
  width: 175rpx;
  height: 32rpx;
  background: rgba(139, 92, 246, 0.56);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
}

/* ============================================
   底部导航栏
   ============================================ */
.tab-bar {
  width: 100%;
  height: 96rpx;
  margin-top: auto;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
  padding-bottom: env(safe-area-inset-bottom);
  flex-shrink: 0;
  margin-top: auto;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #000000;
}

.tab-item.active .tab-label {
  color: #6155F5;
  font-weight: 700;
}
