<!-- ============================================
  moodDetail - 心情库 / 记录展开详情页
  Figma: 375×852 px → 750×1704 rpx
  ============================================ -->

<view class="page">

  <!-- =================== 顶部：标题 + 统计卡片 =================== -->
  <view class="header">
    <view class="header-title">{{nickname}}心情库</view>
    <view class="header-subtitle">共 {{recordCount}} 条记录</view>

    <view class="stats-row">
      <view class="stat-card stat-purple">
        <text class="stat-label">开心</text>
        <text class="stat-value stat-p">61</text>
      </view>
      <view class="stat-card stat-blue">
        <text class="stat-label">平和</text>
        <text class="stat-value">65</text>
      </view>
      <view class="stat-card stat-green">
        <text class="stat-label">生气</text>
        <text class="stat-value stat-g">8</text>
      </view>
    </view>
  </view>

  <!-- =================== 已选中的记录卡片 =================== -->
  <view class="selected-card">
    <view class="sc-left">
      <image class="sc-icon" src="/assets/moodDetail/1.svg" mode="aspectFit"></image>
      <view class="sc-body">
        <view class="sc-mood">{{record.mood}}</view>
        <view class="sc-note-row">
          <text class="sc-note">{{record.note}}</text>
          <text class="sc-score">{{record.score}}</text>
        </view>
      </view>
    </view>
    <view class="sc-right">
      <image class="sc-stats-icon" src="/assets/moodDetail/2.svg" mode="aspectFit"></image>
    </view>
  </view>

  <!-- =================== 展开详情面板 =================== -->
  <view class="detail-panel">
    <view class="detail-inner">

      <!-- 日期 -->
      <text class="detail-date">{{record.date}}</text>

      <!-- 心情行 -->
      <view class="detail-mood-row">
        <image class="detail-mood-icon" src="/assets/moodDetail/5.png" mode="aspectFit"></image>
        <view class="detail-mood-body">
          <text class="detail-mood-name">{{record.mood}}</text>
          <view class="detail-mood-note-row">
            <text class="detail-mood-note">{{record.note}}</text>
            <text class="detail-mood-score">{{record.score}}</text>
          </view>
        </view>
      </view>

      <!-- 语录区 -->
      <view class="detail-quote">
        <text class="detail-quote-text">Cyne：{{record.quote}}</text>
        <text class="detail-quote-text">星星猫："{{record.advice}}"</text>
      </view>

      <!-- 操作按钮 -->
      <view class="detail-actions">
        <view class="btn-detail" bindtap="onHide">隐藏</view>
        <view class="btn-detail" bindtap="onShare">分享</view>
      </view>

    </view>
  </view>

  <!-- =================== 底部导航栏（心情库激活） =================== -->
  <view class="tab-bar">
    <view class="tab-item" data-tab="moodIsland" bindtap="onTabSwitch">
      <image class="tab-icon" src="/assets/moodDetail/4.svg" mode="aspectFit"></image>
      <text class="tab-label">情绪岛</text>
    </view>
    <view class="tab-item active" data-tab="moodLib" bindtap="onTabSwitch">
      <image class="tab-icon" src="/assets/moodDetail/3.svg" mode="aspectFit"></image>
      <text class="tab-label">心情库</text>
    </view>
    <view class="tab-item" data-tab="starTalk" bindtap="onTabSwitch">
      <image class="tab-icon" src="/assets/moodDetail/2.svg" mode="aspectFit"></image>
      <text class="tab-label">星猫说</text>
    </view>
    <view class="tab-item" data-tab="people" bindtap="onTabSwitch">
      <image class="tab-icon" src="/assets/moodDetail/1.svg" mode="aspectFit"></image>
      <text class="tab-label">你我他</text>
    </view>
  </view>

</view>
