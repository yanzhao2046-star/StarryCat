/* ============================================
   growUp.wxss — 星猫成长页
   Figma 313_1778 基准：375px → 750rpx
   对齐 youMeOther：padding 0 60rpx
   ============================================ */

/* ---- 页面容器（对齐 youMeOther） ---- */
.page {
  width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 60rpx;
  display: flex;
  flex-direction: column;
  background: #FFFFFF;
}

/* ---- 可滚动内容 ---- */
.content {
  flex: 1;
  width: 100%;
  overflow: hidden;
}

/* ============================================
   头部渐变区
   Figma: 366×101px, top 11.46px
   渐变: #FFF1F2 → white 70%
   ============================================ */
.header {
  width: 100%;
  margin-top: 24rpx;
  padding: 92rpx 38rpx 28rpx;
  box-sizing: border-box;
  background: linear-gradient(160deg, #FFF1F2 0%, #FFFFFF 70%);
  border-radius: 20rpx;
}

.header-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #101828;
  line-height: 1.4;
}

.header-subtitle {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #101828;
  margin-top: 6rpx;
  line-height: 1.4;
}

/* ============================================
   星猫状态区
   Figma: 358×250px, top 137px, left 25px
   ============================================ */
.cat-section {
  width: 100%;
  margin-top: 46rpx;
}

.cat-section-desc {
  display: block;
  font-size: 32rpx;
  font-weight: 300;
  color: #000000;
  line-height: 1.5;
}

.cat-section-main {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 14rpx;
}

/* 星猫头像圆 */
.cat-avatar-wrap {
  width: 260rpx;
  height: 260rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  background: rgba(97, 85, 245, 0.06);
}

.cat-avatar-img {
  width: 200rpx;
  height: 200rpx;
}

/* 三项数据 */
.cat-stats {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.cat-stats-text {
  font-size: 28rpx;
  font-weight: 300;
  color: #000000;
  line-height: 1.5;
}

/* 总分进度条 */
.cat-progress {
  width: 100%;
  margin-top: 10rpx;
}

.cat-progress-bar {
  width: 100%;
  height: 18rpx;
  background: #EEEEEE;
  border-radius: 20rpx;
  overflow: hidden;
}

.cat-progress-fill {
  height: 100%;
  border-radius: 20rpx;
  background: linear-gradient(90deg, #D9D9D9 0%, #6155F5 100%);
  transition: width 0.5s ease;
}

.cat-progress-label {
  display: block;
  font-size: 28rpx;
  font-weight: 300;
  color: #000000;
  text-align: right;
  margin-top: 10rpx;
}

/* ============================================
   成长规则区
   Figma: 327×235px, top 419px, left 24px
   ============================================ */
.rules-section {
  width: 100%;
  margin-top: 48rpx;
}

.rules-header {
  width: 100%;
  height: 48rpx;
  background: #BA99ED;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rules-title {
  font-size: 24rpx;
  font-weight: 300;
  color: #000000;
}

.rules-body {
  width: 100%;
  margin-top: 12rpx;
  padding: 10rpx;
  box-sizing: border-box;
}

.rules-img {
  width: 100%;
  display: block;
}

/* ============================================
   底部留白
   ============================================ */
.bottom-spacer {
  height: 16rpx;
}


