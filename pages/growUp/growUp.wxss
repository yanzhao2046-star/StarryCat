/* ============================================
   growUp.wxss — 星猫成长页
   Figma 基准：375px → 750rpx (1px = 2rpx)
   容器 padding: 0 30rpx
   紫色系配色，卡片式布局
   ============================================ */

/* ---- 页面级 ---- */
page {
  background: #F8F7FF;
  min-height: 100vh;
}

.page {
  width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 30rpx;
  display: flex;
  flex-direction: column;
  background: #F8F7FF;
}

/* ---- 可滚动内容区 ---- */
.content {
  flex: 1;
  width: 100%;
  overflow: hidden;
}

/* ============================================
   头部：星星猫 + 标题
   图例: 5.svg 头像 + 标题文字
   渐变背景: #FFF1F2 → #FFFFFF
   ============================================ */
.header {
  position: relative;
  width: 100%;
  margin-top: 32rpx;
  min-height: 180rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(160deg, #FFF1F2 0%, #FFFFFF 80%);
}

.header-avatar-wrap {
  width: 140rpx;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.header-avatar {
  width: 140rpx;
  height: 140rpx;
}

.header-text {
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
}

.header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #101828;
}

.header-subtitle {
  font-size: 28rpx;
  font-weight: 400;
  color: #667085;
  margin-top: 4rpx;
}

/* ============================================
   AI 对话入口按钮
   ============================================ */
.chat-entry {
  width: 100%;
  margin-top: 20rpx;
  padding: 24rpx 28rpx;
  background: #FFFFFF;
  border: 2rpx solid #E8E5FF;
  border-radius: 16rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.chat-entry__text {
  font-size: 28rpx;
  font-weight: 500;
  color: #6155F5;
}

.chat-entry__arrow {
  font-size: 28rpx;
  color: #6155F5;
  font-weight: 600;
}

/* ============================================
   整体等级徽章
   ============================================ */
.level-badge {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.level-badge__label {
  font-size: 24rpx;
  color: #98A2B3;
}

.level-badge__title {
  font-size: 36rpx;
  font-weight: 700;
  color: #6155F5;
  background: linear-gradient(135deg, #6155F5, #F59E0B);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* ============================================
   三大指标卡片区
   ============================================ */
.stats-section {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 单个指标卡片 */
.stat-card {
  width: 100%;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(97, 85, 245, 0.06);
}

.stat-card__header {
  display: flex;
  flex-direction: row;
  align-items: center;
}

/* 图标 */
.stat-card__icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.stat-card__icon--token {
  background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
}

.stat-card__icon--wisdom {
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
}

.stat-card__icon--understand {
  background: linear-gradient(135deg, #F3E5F5, #E1BEE7);
}

.stat-card__emoji {
  font-size: 36rpx;
}

/* 数值信息 */
.stat-card__info {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
}

.stat-card__name {
  font-size: 26rpx;
  font-weight: 500;
  color: #344054;
}

.stat-card__value {
  font-size: 40rpx;
  font-weight: 700;
  color: #101828;
  line-height: 1.2;
}

/* 等级称号 */
.stat-card__level {
  flex-shrink: 0;
}

.stat-card__level-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #6155F5;
  background: rgba(97, 85, 245, 0.08);
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
}

/* 进度条 */
.stat-card__progress {
  margin-top: 18rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.stat-card__progress-bar {
  flex: 1;
  height: 10rpx;
  background: #F2F4F7;
  border-radius: 5rpx;
  overflow: hidden;
}

.stat-card__progress-fill {
  height: 100%;
  border-radius: 5rpx;
  background: linear-gradient(90deg, #F59E0B, #F97316);
  transition: width 0.4s ease;
}

.stat-card__progress-fill--wisdom {
  background: linear-gradient(90deg, #34D399, #10B981);
}

.stat-card__progress-fill--understand {
  background: linear-gradient(90deg, #A78BFA, #8B5CF6);
}

.stat-card__progress-text {
  font-size: 20rpx;
  color: #98A2B3;
  flex-shrink: 0;
}

/* ============================================
   星星猫形象卡片 + 个性化问候
   ============================================ */
.cat-card {
  width: 100%;
  margin-top: 24rpx;
  background: linear-gradient(135deg, #EEF2FF, #F5F0FF);
  border-radius: 20rpx;
  padding: 28rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.cat-card__avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cat-card__img {
  width: 90rpx;
  height: 90rpx;
}

.cat-card__body {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.cat-card__greeting {
  font-size: 28rpx;
  font-weight: 600;
  color: #101828;
  line-height: 1.4;
}

.cat-card__desc {
  font-size: 22rpx;
  color: #667085;
  margin-top: 8rpx;
}

/* ============================================
   成长记录 / 积分历史
   ============================================ */
.records-section {
  margin-top: 24rpx;
}

.records-header {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.records-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #101828;
}

.records-count {
  font-size: 22rpx;
  color: #98A2B3;
}

.record-item {
  width: 100%;
  background: #FFFFFF;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.record-item__left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.record-item__desc {
  font-size: 26rpx;
  font-weight: 500;
  color: #344054;
}

.record-item__time {
  font-size: 20rpx;
  color: #98A2B3;
}

.record-item__right {
  display: flex;
  flex-direction: row;
  gap: 8rpx;
  flex-shrink: 0;
}

.record-item__score {
  font-size: 22rpx;
  font-weight: 600;
  color: #F59E0B;
  background: rgba(245, 158, 11, 0.1);
  border-radius: 6rpx;
  padding: 4rpx 10rpx;
}

.record-item__score--wisdom {
  color: #10B981;
  background: rgba(16, 185, 129, 0.1);
}

.record-item__score--understand {
  color: #8B5CF6;
  background: rgba(139, 92, 246, 0.1);
}

/* 空态 */
.records-empty {
  width: 100%;
  background: #FFFFFF;
  border-radius: 14rpx;
  padding: 48rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.records-empty__text {
  font-size: 26rpx;
  color: #98A2B3;
}

.records-empty__hint {
  font-size: 22rpx;
  color: #D0D5DD;
}

/* ============================================
   底部留白
   ============================================ */
.bottom-spacer {
  height: 16rpx;
}

/* ============================================
   底部导航栏
   ============================================ */
.tab-bar {
  width: 100%;
  height: 96rpx;
  flex-shrink: 0;
  margin-top: auto;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFFFFF;
  border-top: 1rpx solid #F2F4F7;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #98A2B3;
}

.tab-item.active .tab-label {
  color: #6155F5;
  font-weight: 700;
}
