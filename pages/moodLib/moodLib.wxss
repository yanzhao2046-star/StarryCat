/* ============================================
   moodLib - 心情库 / 记录列表页
   Figma 基准: 375 × 852 px → 750 × 1704 rpx
   原生 tabBar：page height 由系统扣除 tabBar 后撑满
   ============================================ */

page {
  background: #ffffff;
  min-height: 100vh;
}

.page {
  width: 100%;
  height: 100vh;
  position: relative;
  background: #ffffff;
}

.page-body {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 60rpx;
  padding-bottom: calc(96rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ============================================
   顶部标题 + 统计卡片
   ============================================ */
.header {
  padding-top: 36rpx;
  width: 100%;
  flex-shrink: 0;
  box-shadow: 0 2rpx 0 #F3F4F6;
  padding-bottom: 16rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #101828;
}

.header-subtitle {
  font-size: 28rpx;
  font-weight: 400;
  color: #99A1AF;
  margin-top: 0;
}

/* ---- 标题行：左侧标题 + 右侧按钮 ---- */
.header-top-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
}

/* ---- [心情日历] 按钮 ---- */
.calendar-btn {
  width: 176rpx;
  height: 72rpx;
  background: #7C3AED;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 8rpx;
}

.calendar-btn-text {
  font-size: 28rpx;
  font-weight: 400;
  color: #ffffff;
}

/* ---- 统计卡片行 ---- */
.stats-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 6rpx;
}

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 138rpx;
  border-radius: 32rpx;
  gap: 4rpx;
}

.stat-purple { background: #F5F3FF; }
.stat-blue   { background: #F0F9FF; }
.stat-green  { background: #ECFDF5; }

.stat-label {
  font-size: 20rpx;
  font-weight: 400;
  color: #99A1AF;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #000000;
}

.stat-p { color: #7C3AED; }
.stat-g { color: #009966; }

/* ============================================
   空状态
   ============================================ */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding-bottom: 120rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #99A1AF;
}

.empty-sub {
  font-size: 24rpx;
  font-weight: 400;
  color: #C4CAD3;
}

/* ============================================
   记录列表（可滚动）
   ============================================ */
.list-scroll {
  flex: 1;
  width: 100%;
  padding-top: 16rpx;
  box-sizing: border-box;
}

/* ---- 紧凑列表条目 ---- */
.record-card {
  width: 100%;
  min-height: 120rpx;
  background: #ffffff;
  border-radius: 40rpx;
  box-shadow: 0 0 40rpx rgba(0, 0, 0, 0.10);
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  margin-bottom: 18rpx;
  transition: box-shadow 0.2s;
}

.record-card--expanded {
  box-shadow: 0 0 48rpx rgba(97, 85, 245, 0.18);
}

/* ---- 左侧情绪图标 ---- */
.rc-icon {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
}

/* ---- 中间内容区 ---- */
.rc-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-left: 20rpx;
  overflow: hidden;
}

.rc-mood {
  font-size: 24rpx;
  font-weight: 400;
  color: #000000;
  line-height: 1.3;
}

.rc-note {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.rc-note-txt {
  font-size: 24rpx;
  font-weight: 400;
  color: #4D1A80;
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.rc-score {
  font-size: 21rpx;
  font-weight: 400;
  color: #000000;
  margin-left: 8rpx;
  flex-shrink: 0;
}

/* ---- 右侧粉色+按钮 ---- */
.rc-btn {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-left: 2rpx solid rgba(0, 0, 0, 0.10);
  margin-left: 20rpx;
  padding-left: 20rpx;
  flex-shrink: 0;
}

.rc-btn-icon {
  width: 48rpx;
  height: 48rpx;
}

/* ============================================
   展开详情面板
   ============================================ */
.expand-panel {
  width: 100%;
  margin-bottom: 18rpx;
  animation: fadeSlideIn 0.25s ease;
}

@keyframes fadeSlideIn {
  from {
    opacity: 0;
    transform: translateY(-12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.expand-inner {
  background: #ffffff;
  border: 2rpx solid #F0EEF0;
  border-radius: 48rpx;
  padding: 24rpx;
  box-sizing: border-box;
  background: rgba(97, 85, 245, 0.05);
  border-radius: 44rpx;
  border: 2rpx solid #EDE9FE;
}

/* ---- 时间 ---- */
.exp-time {
  font-size: 20rpx;
  font-weight: 290;
  color: #99A1AF;
  display: block;
  margin-bottom: 16rpx;
}

/* ---- 心情行 ---- */
.exp-mood-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.exp-mood-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}

.exp-mood-body {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.exp-mood-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #000000;
}

.exp-mood-note-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.exp-mood-note {
  font-size: 24rpx;
  color: #4A5565;
}

.exp-mood-score {
  font-size: 21rpx;
  color: #6155F5;
  font-weight: 600;
}

/* ---- 语录区 ---- */
.exp-quote {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #EDE9FE;
  border-bottom: 1rpx solid #EDE9FE;
  margin-bottom: 16rpx;
}

.exp-quote-text {
  font-size: 24rpx;
  color: #4A5565;
  line-height: 1.6;
}

/* ---- 操作按钮 ---- */
.exp-actions {
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 32rpx;
}

.btn-exp {
  width: 170rpx;
  height: 48rpx;
  background: rgba(97, 85, 245, 0.12);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #6155F5;
}

/* 分享至你我他宽按钮 */
.btn-exp--wide {
  width: 320rpx;
  background: linear-gradient(135deg, #6155F5 0%, #8B7CFF 100%);
  color: #FFFFFF;
}

/* ============================================
   底部导航栏
   ============================================ */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: #ffffff;
  width: 100%;
  height: 96rpx;
  padding: 0 60rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #000000;
}

.tab-item.active .tab-label {
  color: #6155F5;
  font-weight: 700;
}

