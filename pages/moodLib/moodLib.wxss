/* ============================================
   moodLib - 心情库 / 记录列表页
   Figma 基准: 375 × 852 px → 750 × 1704 rpx
   原生 tabBar：page height 由系统扣除 tabBar 后撑满
   ============================================ */

page {
  background: #ffffff;
  min-height: 100vh;
}

.page {
  width: 100%;
  height: 100vh;
  position: relative;
  background: #ffffff;
}

.page-body {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  padding-left: 60rpx;
  padding-right: 60rpx;
  padding-top: 284rpx;
  padding-bottom: calc(96rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ============================================
   顶部标题 + 统计卡片
   ============================================ */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 99;
  background: #ffffff;
  padding-top: 36rpx;
  padding-left: 60rpx;
  padding-right: 60rpx;
  padding-bottom: 16rpx;
  width: 100%;
  box-sizing: border-box;
  box-shadow: 0 2rpx 0 #F3F4F6;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #101828;
}

.header-subtitle {
  font-size: 28rpx;
  font-weight: 400;
  color: #99A1AF;
  margin-top: 0;
}

/* ---- 标题行：左侧标题 + 右侧按钮 ---- */
.header-top-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
}

/* ---- [心情日历] 按钮 ---- */
.calendar-btn {
  width: 176rpx;
  height: 72rpx;
  background: #7C3AED;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 8rpx;
}

.calendar-btn-text {
  font-size: 28rpx;
  font-weight: 400;
  color: #ffffff;
}

/* ---- 统计卡片行 ---- */
.stats-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 6rpx;
}

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 138rpx;
  border-radius: 32rpx;
  gap: 4rpx;
}

.stat-purple { background: #F5F3FF; }
.stat-blue   { background: #F0F9FF; }
.stat-green  { background: #ECFDF5; }

.stat-label {
  font-size: 20rpx;
  font-weight: 400;
  color: #99A1AF;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #000000;
}

.stat-p { color: #7C3AED; }
.stat-g { color: #009966; }

/* ============================================
   空状态
   ============================================ */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding-bottom: 120rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #99A1AF;
}

.empty-sub {
  font-size: 24rpx;
  font-weight: 400;
  color: #C4CAD3;
}

/* ============================================
   记录列表（可滚动）
   ============================================ */
.list-scroll {
  flex: 1;
  width: 100%;
  padding-top: 16rpx;
  box-sizing: border-box;
}

/* ---- 紧凑列表条目 (frame3279) ---- */
.record-card {
  width: 100%;
  min-height: 120rpx;
  background: #ffffff;
  border-radius: 40rpx;
  box-shadow: 0 0 40rpx rgba(0, 0, 0, 0.10);
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx;
  box-sizing: border-box;
  margin-bottom: 18rpx;
  transition: box-shadow 0.2s;
}

.record-card--expanded {
  box-shadow: 0 0 48rpx rgba(97, 85, 245, 0.18);
}

/* ---- 左侧情绪图标 ---- */
.rc-icon {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
}

/* ---- 中间内容区（三行布局） ---- */
.rc-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-left: 20rpx;
  overflow: hidden;
  min-width: 0;
}

/* 第一行：记录时间 + 分数 */
.rc-row-time {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 8rpx;
}

.rc-time {
  font-size: 20rpx;
  font-weight: 290;
  color: #101828;
  line-height: 1;
}

.rc-score {
  font-size: 20rpx;
  font-weight: 290;
  color: #8B5CF6;
  line-height: 1;
  flex-shrink: 0;
}

/* 第二行：情绪名称 + 黑话 */
.rc-row-info {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 8rpx;
  flex-wrap: nowrap;
  overflow: hidden;
  margin-top: 8rpx;
}

.rc-mood {
  font-size: 24rpx;
  font-weight: 400;
  color: #000000;
  flex-shrink: 0;
  line-height: 1.2;
}

.rc-note-txt {
  font-size: 24rpx;
  font-weight: 400;
  color: #4D1A80;
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  min-width: 0;
  line-height: 1.2;
}

/* 第三行：语录 */
.rc-quote {
  font-size: 24rpx;
  font-weight: 400;
  color: #4A5565;
  margin-top: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  line-height: 1.2;
}

/* ---- 右侧+按钮 ---- */
.rc-btn {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-left: 2rpx solid rgba(0, 0, 0, 0.10);
  margin-left: 20rpx;
  padding-left: 20rpx;
  flex-shrink: 0;
}

.rc-btn-icon {
  width: 48rpx;
  height: 48rpx;
}

/* ============================================
   展开详情面板 (Frame 2147224327)
   ============================================ */
.expand-panel {
  width: 100%;
  margin-bottom: 18rpx;
  margin-top: -8rpx;
  animation: fadeSlideIn 0.25s ease;
}

@keyframes fadeSlideIn {
  from {
    opacity: 0;
    transform: translateY(-12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 外层：边框容器 */
.expand-outer {
  width: 100%;
  border: 2rpx solid #F0EEF0;
  border-radius: 48rpx;
  padding: 7rpx;
  box-sizing: border-box;
}

/* 内层：半透明背景 */
.expand-inner {
  background: rgba(97, 85, 245, 0.10);
  border-radius: 44rpx;
  padding: 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

/* ---- 星星猫语录 ---- */
.exp-quote-text {
  font-size: 24rpx;
  font-weight: 400;
  color: #4A5565;
  text-align: center;
  line-height: 1.6;
}

/* ---- 操作按钮 ---- */
.exp-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  justify-content: center;
}

/* 分享至你我他 */
.btn-exp--share {
  padding: 0 24rpx;
  height: 48rpx;
  background: rgba(139, 92, 246, 0.56);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
  white-space: nowrap;
}

.btn-exp--share:active {
  opacity: 0.8;
}

/* 自言自语 */
.btn-exp--mono {
  padding: 0 24rpx;
  height: 48rpx;
  background: rgba(139, 92, 246, 0.56);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
  white-space: nowrap;
}

.btn-exp--mono:active {
  opacity: 0.8;
}

/* ============================================
   底部导航栏
   ============================================ */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: #ffffff;
  width: 100%;
  height: 96rpx;
  padding: 0 60rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #000000;
}

.tab-item.active .tab-label {
  color: #6155F5;
  font-weight: 700;
}

/* 自言自语有记录时高亮 */
.btn-exp--mono--has {
  background: rgba(139, 92, 246, 0.78);
}

/* ============================================
   自言自语弹窗
   ============================================ */
.mono-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 200;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mono-popup {
  width: 560rpx;
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 32rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  animation: monoPopIn 0.25s ease;
}

@keyframes monoPopIn {
  from { opacity: 0; transform: scale(0.92); }
  to   { opacity: 1; transform: scale(1); }
}

.mono-count-tag {
  font-size: 22rpx;
  color: rgba(139, 92, 246, 0.65);
  text-align: center;
  display: block;
}

.mono-history-empty {
  text-align: center;
  padding: 20rpx 0;
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.25);
}

.mono-history {
  max-height: 200rpx;
  background: rgba(183, 156, 250, 0.16);
  border-radius: 18rpx;
  padding: 16rpx 24rpx;
}

.mono-history-item {
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(139, 92, 246, 0.12);
}

.mono-history-item:last-child {
  border-bottom: none; padding-bottom: 0;
}

.mono-history-time {
  font-size: 22rpx;
  color: rgba(139, 92, 246, 0.65);
  margin-bottom: 6rpx;
}

.mono-history-text {
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.72);
  line-height: 1.5;
  word-break: break-all;
}

.mono-body {
  background: rgba(183, 156, 250, 0.31);
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  min-height: 200rpx;
}

.mono-textarea {
  width: 100%;
  min-height: 160rpx;
  max-height: 320rpx;
  font-size: 26rpx;
  color: #000000;
  line-height: 1.6;
}

.mono-toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
  height: 64rpx;
  background: rgba(183, 156, 250, 0.42);
  border-radius: 22rpx;
  padding: 0 16rpx;
}

.mono-tool {
  width: 48rpx; height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mono-tool:active { opacity: 0.6; }

.mono-tool-icon {
  width: 48rpx; height: 48rpx;
}

/* ---- 待发送图片预览区 ---- */
.mono-img-preview {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.mono-img-preview-item {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.mono-img-preview-thumb {
  width: 100%;
  height: 100%;
}

.mono-img-preview-del {
  position: absolute;
  top: 2rpx;
  right: 2rpx;
  width: 34rpx;
  height: 34rpx;
  background: rgba(0, 0, 0, 0.50);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
  line-height: 1;
}

/* ---- 历史记录中的图片缩略图 ---- */
.mono-history-imgs {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.mono-history-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 10rpx;
}

