<!-- ============================================
  moodLib - 心情库 / 记录列表页
  Figma 基准: 375 × 852 px → 750 × 1704 rpx
  ============================================ -->

<wxs module="iconMap">
var icons = ['超开心','偷偷小得意','充满干劲','有点迷糊','认真专注',
             '有点沮丧','想歇一会','烦躁生气','感恩','热爱劳动',
             '团队合作','心情DIY'];
var pool = [5,7,9,11,13,15,17,20,5,7,9,11];
module.exports = function(mood) {
  var idx = icons.indexOf(mood);
  var num = pool[idx] || 5;
  var ext = '.svg';
  if (num === 5 || num === 7 || num === 11 || num === 17) {
    ext = '.png';
  }
  return '/assets/moodLib/' + num + ext;
}
</wxs>
<wxs module="fmt">
// 时间格式化 → "MM.DD HH:mm"（去掉年份）
//   兼容格式A: "2026-08-06 14:30"（横杠+空格）
//   兼容格式B: "2026.08.06.14:30"（全点号）
module.exports.t = function(timeStr) {
  if (!timeStr) return '';
  var d, t;
  if (timeStr.indexOf(' ') !== -1) {
    // 格式A: "2026-08-06 14:30"
    var arr = timeStr.split(' ');
    d = arr[0].split('-');
    t = arr[1].split(':');
  } else {
    // 格式B: "2026.08.06.14:30"
    var parts = timeStr.split('.');
    if (parts.length < 4) return timeStr;
    d = [parts[0], parts[1], parts[2]];
    t = parts[3].split(':');
  }
  if (d.length < 3 || t.length < 2) return timeStr;
  return d[1] + '.' + d[2] + ' ' + t[0] + ':' + t[1];
};
</wxs>

<view class="page">

  <!-- =================== 顶部：标题 + 统计卡片（固定） =================== -->
  <view class="header">
    <view class="header-top-row">
      <view>
        <view class="header-title">{{nickname}}心情库</view>
        <view class="header-subtitle">共 {{recordCount}} 条记录</view>
      </view>
      <view class="calendar-btn" bindtap="onCalendarTap">
        <text class="calendar-btn-text">心情日历</text>
      </view>
    </view>

    <view class="stats-row">
      <view class="stat-card stat-purple">
        <text class="stat-label">开心</text>
        <text class="stat-value stat-p">{{happyAvg}}</text>
      </view>
      <view class="stat-card stat-blue">
        <text class="stat-label">平和</text>
        <text class="stat-value">{{calmAvg}}</text>
      </view>
      <view class="stat-card stat-green">
        <text class="stat-label">生气</text>
        <text class="stat-value stat-g">{{angryAvg}}</text>
      </view>
    </view>
  </view>

  <scroll-view class="page-body" scroll-y="true" enhanced="true" show-scrollbar="{{false}}">

  <!-- =================== 空状态占位 =================== -->
  <view class="empty-state" wx:if="{{isEmpty}}">
    <image class="empty-icon" src="/assets/moodLib/20.svg" mode="aspectFit"></image>
    <text class="empty-text">还没有小火苗</text>
    <text class="empty-sub">去情绪岛记录你的心情吧</text>
  </view>

  <!-- =================== 记录列表 =================== -->
  <view class="list-scroll" wx:if="{{!isEmpty}}">

    <block wx:for="{{displayList}}" wx:key="id">

      <!-- ====== 紧凑列表条目 (三行布局) ====== -->
      <view class="record-card {{expandedId === item.id ? 'record-card--expanded' : ''}}">
        <!-- 左侧情绪头像 -->
        <image class="rc-icon" src="{{iconMap(item.currentMoodType)}}" mode="aspectFit"></image>

        <!-- 中间内容：三行 -->
        <view class="rc-body">
          <!-- 第一行：记录时间 + 分数 -->
          <view class="rc-row-time">
            <text class="rc-time">{{fmt.t(item.time)}}</text>
            <text class="rc-score">{{item.moodEnergy}}</text>
          </view>
          <!-- 第二行：情绪名称 + 黑话 -->
          <view class="rc-row-info">
            <text class="rc-mood">{{item.currentMoodType}}</text>
            <text class="rc-note-txt">{{item.shareText || '—'}}</text>
          </view>
          <!-- 第三行：语录 -->
          <text class="rc-quote" wx:if="{{item.eventText}}">{{nickname}}：{{item.eventText}}</text>
        </view>

        <!-- 右侧+按钮 -->
        <view class="rc-btn" catchtap="onExpandToggle" data-id="{{item.id}}">
          <image class="rc-btn-icon" src="/assets/moodLib/6.svg" mode="aspectFit"></image>
        </view>
      </view>

      <!-- ====== 展开详情面板 (Frame 2147224327) ====== -->
      <view class="expand-panel" wx:if="{{expandedId === item.id}}">
        <view class="expand-outer">
          <view class="expand-inner">
            <text class="exp-quote-text" wx:if="{{item.shareTip}}">星星猫："{{item.shareTip}}"</text>

            <view class="exp-actions">
              <view class="btn-exp--share" catchtap="onShareToYouMe" data-id="{{item.id}}">分享至你我他</view>
              <view class="btn-exp--mono {{monoCountMap[item.id] ? 'btn-exp--mono--has' : ''}}" catchtap="onMonologueOpen" data-id="{{item.id}}">自言自语<text wx:if="{{monoCountMap[item.id]}}">+{{monoCountMap[item.id]}}</text></view>
            </view>
          </view>
        </view>
      </view>

    </block>

  </view>

  </scroll-view>

  <!-- =================== 底部导航栏（心情库激活） =================== -->
  <view class="tab-bar">
    <view class="tab-item" data-tab="moodIsland" bindtap="onTabSwitch">
      <image class="tab-icon" src="/assets/moodLib/4.svg" mode="aspectFit"></image>
      <text class="tab-label">情绪岛</text>
    </view>
    <view class="tab-item active" data-tab="moodLib" bindtap="onTabSwitch">
      <image class="tab-icon" src="/assets/moodLib/3.svg" mode="aspectFit"></image>
      <text class="tab-label">心情库</text>
    </view>
    <view class="tab-item" data-tab="starTalk" bindtap="onTabSwitch">
      <image class="tab-icon" src="/assets/moodLib/2.svg" mode="aspectFit"></image>
      <text class="tab-label">星猫说</text>
    </view>
    <view class="tab-item" data-tab="people" bindtap="onTabSwitch">
      <image class="tab-icon" src="/assets/moodLib/1.svg" mode="aspectFit"></image>
      <text class="tab-label">你我他</text>
    </view>
  </view>

  <!-- =================== 自言自语弹窗 =================== -->
  <view class="mono-overlay" wx:if="{{showMonoPopup}}" catchtap="onMonoClose">
    <view class="mono-popup" catchtap="noop">
      <!-- 记录计数 -->
      <text class="mono-count-tag" wx:if="{{monoHistory.length > 0}}">共{{monoHistory.length}}条自言自语</text>

      <!-- 历史记录区（E区） -->
      <view wx:if="{{monoHistory.length === 0}}" class="mono-history-empty">暂无历史记录</view>
      <scroll-view wx:else class="mono-history" scroll-y="true">
        <view class="mono-history-item" wx:for="{{monoHistory}}" wx:key="id">
          <view class="mono-history-time">{{item._fmtTime || ''}}</view>
          <view class="mono-history-text" wx:if="{{item.content}}">{{item.content}}</view>
          <!-- 历史图片缩略图 -->
          <view class="mono-history-imgs" wx:if="{{item.images && item.images.length > 0}}">
            <image
              wx:for="{{item.images}}"
              wx:key="index"
              class="mono-history-thumb"
              src="{{item}}"
              mode="aspectFill"
              catchtap="onMonoPreviewImage"
              data-url="{{item}}"
              data-urls="{{item.images.join('||')}}"
            ></image>
          </view>
        </view>
      </scroll-view>

      <!-- 内容区 -->
      <view class="mono-body">
        <!-- 待发送图片预览 -->
        <view class="mono-img-preview" wx:if="{{monoImages.length > 0}}">
          <view class="mono-img-preview-item" wx:for="{{monoImages}}" wx:key="index">
            <image class="mono-img-preview-thumb" src="{{item}}" mode="aspectFill"></image>
            <view class="mono-img-preview-del" catchtap="onMonoRemoveImage" data-index="{{index}}">✕</view>
          </view>
        </view>
        <textarea class="mono-textarea" placeholder="在这里自言自语" placeholder-style="color:rgba(0,0,0,0.18)" value="{{monoContent}}" bindinput="onMonoContentInput" maxlength="500" auto-height="{{false}}"/>
      </view>

      <!-- 工具栏 -->
      <view class="mono-toolbar">
        <view class="mono-tool mono-tool--check" catchtap="onMonoSave">
          <image class="mono-tool-icon" src="/assets/moodLib/mono_check.svg" mode="aspectFit"></image>
        </view>
        <view class="mono-tool mono-tool--mic" catchtap="onMonoVoice">
          <image class="mono-tool-icon" src="/assets/moodLib/mono_mic.svg" mode="aspectFit"></image>
        </view>
        <view class="mono-tool mono-tool--clip" catchtap="onMonoAttach">
          <image class="mono-tool-icon" src="/assets/moodLib/mono_clip.svg" mode="aspectFit"></image>
        </view>
        <view class="mono-tool mono-tool--trash" catchtap="onMonoDelete">
          <image class="mono-tool-icon" src="/assets/moodLib/mono_trash.svg" mode="aspectFit"></image>
        </view>
      </view>
    </view>
  </view>

</view>
