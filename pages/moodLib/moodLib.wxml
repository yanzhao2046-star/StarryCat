<!-- ============================================
  moodLib - 心情库 / 记录列表页
  Figma 基准: 375 × 852 px → 750 × 1704 rpx
  ============================================ -->

<wxs module="iconMap">
var icons = ['超开心','偷偷小得意','充满干劲','有点迷糊','认真专注',
             '有点沮丧','想歇一会','烦躁生气','感恩','热爱劳动',
             '团队合作','心情DIY'];
var pool = [5,7,9,11,13,15,17,20,5,7,9,11];
module.exports = function(mood) {
  var idx = icons.indexOf(mood);
  var num = pool[idx] || 5;
  var ext = '.svg';
  if (num === 5 || num === 7 || num === 11 || num === 17) {
    ext = '.png';
  }
  return '/assets/moodLib/' + num + ext;
}
</wxs>

<view class="page">

  <!-- =================== 顶部：标题 + 统计卡片 =================== -->
  <view class="header">
    <view class="header-top-row">
      <view>
        <view class="header-title">{{nickname}}心情库</view>
        <view class="header-subtitle">共 {{recordCount}} 条记录</view>
      </view>
      <view class="calendar-btn" bindtap="onCalendarTap">
        <text class="calendar-btn-text">心情日历</text>
      </view>
    </view>

    <view class="stats-row">
      <view class="stat-card stat-purple">
        <text class="stat-label">开心</text>
        <text class="stat-value stat-p">{{happyAvg}}</text>
      </view>
      <view class="stat-card stat-blue">
        <text class="stat-label">平和</text>
        <text class="stat-value">{{calmAvg}}</text>
      </view>
      <view class="stat-card stat-green">
        <text class="stat-label">生气</text>
        <text class="stat-value stat-g">{{angryAvg}}</text>
      </view>
    </view>
  </view>

  <!-- =================== 空状态占位 =================== -->
  <view class="empty-state" wx:if="{{isEmpty}}">
    <image class="empty-icon" src="/assets/moodLib/20.svg" mode="aspectFit"></image>
    <text class="empty-text">还没有小火苗</text>
    <text class="empty-sub">去情绪岛记录你的心情吧</text>
  </view>

  <!-- =================== 记录列表（可滚动） =================== -->
  <scroll-view class="list-scroll" wx:if="{{!isEmpty}}" scroll-y show-scrollbar="{{false}}">

    <block wx:for="{{displayList}}" wx:key="id">

      <!-- ====== 紧凑列表条目 ====== -->
      <view class="record-card {{expandedId === item.id ? 'record-card--expanded' : ''}}">
        <!-- 左侧情绪头像 -->
        <image class="rc-icon" src="{{iconMap(item.currentMoodType)}}" mode="aspectFit"></image>

        <!-- 中间内容 -->
        <view class="rc-body">
          <text class="rc-mood">{{item.currentMoodType}}</text>
          <view class="rc-note">
            <text class="rc-note-txt">{{item.shareText || '—'}}</text>
            <text class="rc-score">{{item.moodEnergy}}</text>
          </view>
        </view>

        <!-- 右侧粉色+按钮 -->
        <view class="rc-btn" catchtap="onExpandToggle" data-id="{{item.id}}">
          <image class="rc-btn-icon" src="/assets/moodLib/6.svg" mode="aspectFit"></image>
        </view>
      </view>

      <!-- ====== 展开详情面板 ====== -->
      <view class="expand-panel" wx:if="{{expandedId === item.id}}">
        <view class="expand-inner">

          <!-- 记录时间 -->
          <text class="exp-time">{{item.time}}</text>

          <!-- 心情行 -->
          <view class="exp-mood-row">
            <image class="exp-mood-icon" src="{{iconMap(item.currentMoodType)}}" mode="aspectFit"></image>
            <view class="exp-mood-body">
              <text class="exp-mood-name">{{item.currentMoodType}}</text>
              <view class="exp-mood-note-row">
                <text class="exp-mood-note">{{item.shareText || '—'}}</text>
                <text class="exp-mood-score">{{item.moodEnergy}}</text>
              </view>
            </view>
          </view>

          <!-- 用户语录 + 星星猫建议 -->
          <view class="exp-quote" wx:if="{{item.eventText || item.shareTip}}">
            <text class="exp-quote-text" wx:if="{{item.eventText}}">{{nickname}}：{{item.eventText}}</text>
            <text class="exp-quote-text" wx:if="{{item.shareTip}}">星星猫："{{item.shareTip}}"</text>
          </view>

          <!-- 操作按钮 -->
          <view class="exp-actions">
            <view class="btn-exp btn-exp--wide" catchtap="onShareToYouMe" data-id="{{item.id}}">分享至你我他</view>
          </view>

        </view>
      </view>

    </block>

  </scroll-view>

  <!-- =================== 底部导航栏（心情库激活） =================== -->
  <view class="tab-bar">
    <view class="tab-item" data-tab="moodIsland" bindtap="onTabSwitch">
      <image class="tab-icon" src="/assets/moodLib/4.svg" mode="aspectFit"></image>
      <text class="tab-label">情绪岛</text>
    </view>
    <view class="tab-item active" data-tab="moodLib" bindtap="onTabSwitch">
      <image class="tab-icon" src="/assets/moodLib/3.svg" mode="aspectFit"></image>
      <text class="tab-label">心情库</text>
    </view>
    <view class="tab-item" data-tab="starTalk" bindtap="onTabSwitch">
      <image class="tab-icon" src="/assets/moodLib/2.svg" mode="aspectFit"></image>
      <text class="tab-label">星猫说</text>
    </view>
    <view class="tab-item" data-tab="people" bindtap="onTabSwitch">
      <image class="tab-icon" src="/assets/moodLib/1.svg" mode="aspectFit"></image>
      <text class="tab-label">你我他</text>
    </view>
  </view>

</view>
