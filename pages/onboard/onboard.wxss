/* ============================================================
   onboard - 开屏页样式（Figma 1800_312）
   画布 375×852，背景 #FFDB01（1px = 2rpx）
   - 品牌字  三行 top:140 → 280rpx，YaHei 32px→64rpx 黑
   - 猫图    375×489 @ top:363 → 750×978rpx 贴底
   - 长按时间环：canvas 2d，叠在猫身上，3 秒压满进猫房
   ============================================================ */

page {
  background: #FFDB01;
}

.splash {
  width: 100%;
  height: 100vh;
  background: #FFDB01;
  position: relative;
  overflow: hidden;
}

/* ------ 猫形象：1800_312/1.png（384×478），贴屏幕底部 ------ */
.cat-stack {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 750rpx;
  z-index: 1;
}

.cat-layer {
  display: block;
  width: 750rpx;
}

/* ------ 品牌字（Figma 1800_312：top:140 → 280rpx，三行居中） ------ */
.brand {
  position: absolute;
  left: 0;
  top: 280rpx;
  width: 100%;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: brand-in 600ms ease-out both;
}

.brand-line {
  font-size: 64rpx;               /* Figma 32px → 64rpx */
  font-weight: 700;
  font-family: 'Microsoft YaHei UI', 'PingFang SC', sans-serif;
  color: #000000;
  line-height: 1.18;              /* Figma 138px 容器 / 4 行 ≈ 34.5px */
  text-align: center;
}

/* ------ 长按时间环（canvas 2d，压满进猫房） ------ */
/* 位置：猫图中心偏上（猫头位置），不挡手势 */
.press-ring {
  position: absolute;
  left: 50%;
  top: 32%;
  width: 200rpx;
  height: 200rpx;
  margin: -100rpx 0 0 -100rpx;
  opacity: 0;
  transition: opacity 180ms ease;
  pointer-events: none;           /* 不拦截长按手势 */
  z-index: 3;
}

.press-ring--on {
  opacity: 1;
}

.ring-canvas {
  width: 100%;
  height: 100%;
}

/* ------ 动画 ------ */
@keyframes brand-in {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
