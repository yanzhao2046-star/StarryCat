/* ============================================================
   onboard - 开屏页样式（Figma 1800_312）
   画布 375×852，背景 #FFDB01（1px = 2rpx）
   - 品牌字  三行 top:140 → 280rpx，YaHei 32px→64rpx 黑
   - 猫图    375×489 @ top:363 → 750×978rpx 贴底
   - 长按时间环：canvas 2d，叠在猫身上，3 秒压满进猫房
   ============================================================ */

page {
  background: #FFDB01;
}

.splash {
  width: 100%;
  height: 100vh;
  background: #FFDB01;
  position: relative;
  overflow: hidden;
}

/* ------ 猫形象：1800_312/1.png（384×478），贴屏幕底部 ------ */
.cat-stack {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 750rpx;
  z-index: 1;
}

.cat-layer {
  display: block;
  width: 750rpx;
}

/* ------ 品牌字（Figma 1800_312：top:140 → 280rpx，三行居中） ------ */
.brand {
  position: absolute;
  left: 0;
  top: 280rpx;
  width: 100%;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: brand-in 600ms ease-out both;
}

.brand-line {
  font-size: 64rpx;               /* Figma 32px → 64rpx */
  font-weight: 700;
  font-family: 'Microsoft YaHei UI', 'PingFang SC', sans-serif;
  color: #000000;
  line-height: 1.18;              /* Figma 138px 容器 / 4 行 ≈ 34.5px */
  text-align: center;
}

/* ------ 长按时间环（canvas 2d，压满进猫房） ------ */
/* 位置：跟随手指（left/top 由 js 用 clientX/Y 动态写入，px），
   transform 负偏移让环心对准指尖；不挡手势 */
.press-ring {
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  transform: translate(-50%, -50%);
  opacity: 0;
  transition: opacity 180ms ease;
  pointer-events: none;           /* 不拦截长按手势 */
  z-index: 3;
}

.press-ring--on {
  opacity: 1;
}

.ring-canvas {
  width: 100%;
  height: 100%;
}

/* ============================================================
   首次进入：全屏玩法介绍页（Figma 1804_511）
   画布 402×874，1px = 2rpx
     标题 left:137 top:242 w:187 → 274, 484rpx 居中
     左图 left:15  top:305 161×288 → 30, 610rpx, 322×576rpx
     右文 left:184 top:309 187×296 → 368, 618rpx, 374×592rpx
     底部「我知道了」按钮 居中
   ============================================================ */
.intro {
  position: absolute;
  inset: 0;
  z-index: 4;                 /* 高于 press-ring 3，盖住猫区 */
  background: #FFDB01;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 40rpx 100rpx;
  box-sizing: border-box;
  animation: intro-in 280ms ease-out both;
}

.intro-title {
  margin-top: 280rpx;          /* Figma top:242 → 484rpx - 字号一半 64/2 居中 */
  font-size: 64rpx;             /* Figma 32px → 64rpx */
  font-weight: 700;
  font-family: 'Microsoft YaHei UI', 'PingFang SC', sans-serif;
  color: #000000;
  line-height: 1.2;
  text-align: center;
}

.intro-body {
  margin-top: 60rpx;
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 30rpx;
}

.intro-img {
  flex: 0 0 auto;
  width: 322rpx;               /* Figma 161×288，等比 */
  height: 576rpx;
  display: block;
  background: transparent;
}

.intro-text {
  flex: 1 1 auto;
  min-width: 0;
  padding-top: 12rpx;
}

.intro-p {
  display: block;
  margin-bottom: 22rpx;
  font-size: 24rpx;             /* Figma 12px → 24rpx */
  font-weight: 500;
  font-family: 'Noto Sans SC', 'PingFang SC', sans-serif;
  color: #000000;
  line-height: 1.55;
  word-break: break-word;
  white-space: pre-wrap;
}
.intro-p:last-child { margin-bottom: 0; }

/* 「我知道了」按钮：黑底白字圆角胶囊，靠底 */
.intro-btn {
  margin-top: auto;
  margin-bottom: 40rpx;
  width: 360rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #000000;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 120ms ease, transform 120ms ease;
}
.intro-btn text {
  font-size: 30rpx;
  font-weight: 600;
  font-family: 'Microsoft YaHei UI', 'PingFang SC', sans-serif;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}
.intro-btn--hover { opacity: 0.7; transform: scale(0.98); }

@keyframes intro-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* ------ 动画 ------ */
@keyframes brand-in {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
