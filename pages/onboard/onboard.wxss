/* ============================================================
   onboard - 开屏页样式（Figma 503_1510）
   画布 375×852，背景 #FFDB01（1px = 2rpx）
   - 品牌字  top:86  → 172rpx，72rpx 黑
   - 开门图  83×89 @ (146,194) → 166×178rpx @ (292rpx,388rpx)
   - 进入    15px @ y287 → 30rpx
   - 猫图    375×489 @ top:363 → 750×978rpx 贴底
   ============================================================ */

page {
  background: #FFDB01;
}

.splash {
  width: 100%;
  height: 100vh;
  background: #FFDB01;
  position: relative;
  overflow: hidden;
}

/* ------ 猫形象：整张静态图，贴屏幕底部 ------ */
/* 2.png 比例 375:489，750rpx 宽 → 实际高 ≈978rpx，容器高度自适应 */
.cat-stack {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 750rpx;
  z-index: 1;
}

.cat-layer {
  display: block;
  width: 750rpx;
}


/* ------ 品牌字 ------ */
.brand {
  position: absolute;
  left: 184rpx;
  top: 172rpx;
  width: 384rpx;
  height: 276rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;   /* Figma 文字框顶部对齐 */
  align-items: center;
  animation: brand-in 600ms ease-out both;
}

.brand-line {
  font-size: 72rpx;
  font-weight: 400;
  color: #000000;
  line-height: 1.2;              /* Figma Inter 36px 自动行高 ≈ 43px */
  text-align: center;
}

/* ------ 开门入口（唯一点击区）------ */
.door-wrap {
  position: absolute;
  left: 292rpx;
  top: 388rpx;
  width: 166rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: door-pulse 2s ease-in-out infinite;
}

.door {
  width: 166rpx;
  height: 178rpx;
}

.enter-hint {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 400;
  color: #000000;
  text-align: center;
}

.door-hover {
  opacity: 0.65;
}

/* ------ 动画 ------ */
@keyframes brand-in {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes door-pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.06);
  }
}
