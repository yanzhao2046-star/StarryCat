<!-- ============================================
    onboard - 开屏页（Figma 503_1510）
    星星猫 · 375×852 → 750×1704rpx（1px=2rpx）
    交互：8 向视线猫 —— 手指触摸全屏任意处，猫头/眼睛看向手指方向；
          抬手 600ms 后回到「上方」待机帧
    入口：点击「开门」图片进入主功能，无自动跳转
    ============================================ -->

<view class="splash"
  bindtouchstart="onGazeTouch"
  bindtouchmove="onGazeTouch"
  bindtouchend="onGazeEnd"
  bindtouchcancel="onGazeEnd"
>

  <!-- 静态兜底猫：canvas 8 帧全部预加载完成（画好待机帧）后隐藏，先画后藏无闪烁 -->
  <view class="cat-stack" wx:if="{{catFallback}}">
    <image webp="{{true}}" class="cat-layer cat-body" src="/assets/CodeBuddyAssets/503_1510/2.png" mode="widthFix" />
  </view>

  <!-- 8 向视线猫：512×512 整猫素材，身体固定仅头部跟随，贴底铺满 -->
  <canvas type="2d" id="gazeCanvas" class="cat-canvas"></canvas>

  <!-- 品牌字：top:86 → 172rpx -->
  <view class="brand">
    <text class="brand-line">星星猫</text>
  </view>

  <!-- 开门入口：83×89 → 166×178rpx，top:194 → 388rpx，点击进入 -->
  <view class="door-wrap" bindtap="goHome" hover-class="door-hover">
    <image webp="{{true}}"
      class="door"
      src="/assets/CodeBuddyAssets/503_1510/1.png"
      mode="aspectFit"
    />
    <text class="enter-hint">进入</text>
  </view>

</view>
