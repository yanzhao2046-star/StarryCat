<!-- ============================================
    onboard - 开屏页（Figma 1800_312）
    星星猫 · 375×852 → 750×1704rpx（1px=2rpx）
    猫形象：1800_312/1.png 375×489，贴底
    入口：无 icon —— 长按猫 3 秒（时间环压满）进猫房
    ============================================ -->

<view class="splash">

  <!-- 品牌字：三行（Figma top:140 → 280rpx，水平居中） -->
  <view class="brand">
    <text class="brand-line">星星猫</text>
    <text class="brand-line">宇宙</text>
    <text class="brand-line">Starrycat</text>
  </view>

  <!-- 猫：整块可按区，长按 3 秒时间环压满后进猫房 -->
  <view class="cat-stack"
        bindtouchstart="onPressStart"
        bindtouchend="onPressEnd"
        bindtouchcancel="onPressEnd">
    <image class="cat-layer" src="/assets/CodeBuddyAssets/1800_312/1.png" mode="widthFix" />

    <!-- 长按时间环：canvas 2d 画环形进度，按住时淡入 -->
    <view class="press-ring {{pressing ? 'press-ring--on' : ''}}">
      <canvas type="2d" id="ringCanvas" class="ring-canvas"></canvas>
    </view>
  </view>

</view>
