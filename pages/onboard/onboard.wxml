<!-- ============================================
    onboard - 开屏页（Figma 3_5）
    星星猫 · 375×852 → 750×1704rpx（1px=2rpx）
    猫形象：单张静态图（参考图「首页动画」735×1319，贴底 widthFix）
    入口：无 icon —— 点击「进入」文字直接进猫房
    ============================================ -->

<view class="splash">

  <!-- 猫形象：750rpx 宽贴底，widthFix 自适应高 ≈1346rpx，整图无裁切 -->
  <view class="cat-stack">
    <image class="cat-layer cat-body" src="/assets/CodeBuddyAssets/onboardCat/main.jpg" mode="widthFix" />
  </view>

  <!-- 品牌字：Figma 3_5 top:231 → 462rpx -->
  <view class="brand">
    <text class="brand-line">星星猫</text>
  </view>

  <!-- 进入入口（唯一点击区）：无 icon，点击直接进入 -->
  <view class="enter-wrap" bindtap="goHome" hover-class="enter-hover">
    <text class="enter-text">进入</text>
  </view>

</view>
