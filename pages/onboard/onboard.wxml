<!-- ============================================
    onboard - 开屏页（Figma 503_1510）
    星星猫 · 375×852 → 750×1704rpx（1px=2rpx）
    手指跟随：单张精灵动态旋转 —— touchmove 由 WXS 在视图层处理
    （零 setData），连续 atan2 角度 + lerp(0.18) 缓动跟随，抬手缓回正
    入口：点击「开门」图片进入主功能，无自动跳转
    ============================================ -->

<wxs module="gaze" src="./gaze.wxs"></wxs>

<view class="splash"
  data-cx="{{gazeCX}}"
  data-cy="{{gazeCY}}"
  bindtouchstart="{{gaze.onStart}}"
  bindtouchmove="{{gaze.onMove}}"
  bindtouchend="{{gaze.onEnd}}"
  bindtouchcancel="{{gaze.onEnd}}"
>

  <!-- 手指跟随猫：单张方形精灵（catGaze/up.png），绕中心连续旋转 -->
  <image id="catRot" class="cat-rot"
    src="/assets/CodeBuddyAssets/catGaze/up.png"
    mode="aspectFit"
  />

  <!-- 品牌字：top:86 → 172rpx -->
  <view class="brand">
    <text class="brand-line">星星猫</text>
  </view>

  <!-- 开门入口：83×89 → 166×178rpx，top:194 → 388rpx，点击进入 -->
  <view class="door-wrap" bindtap="goHome" hover-class="door-hover">
    <image webp="{{true}}"
      class="door"
      src="/assets/CodeBuddyAssets/503_1510/1.png"
      mode="aspectFit"
    />
    <text class="enter-hint">进入</text>
  </view>

</view>
