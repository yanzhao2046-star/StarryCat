/* ============================================================
   pages/catItem/catItem.wxss — 猫物
   Figma 429_1103：402px 画布 → 1px ≈ 1.866rpx
   尺寸按 1px ≈ 1.866rpx 换算，四周统一 32rpx 边距
   ============================================================ */

.page {
  min-height: 100vh;
  background: #FFFFFF;
  position: relative;
  padding-bottom: 220rpx;
  box-sizing: border-box;
}

/* ============== 顶部 header ============== */
/* 与「猫的心情」页统一：图标 66×66rpx；标题 28rpx；上 36rpx · 下 16rpx */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 36rpx;
  padding-bottom: 16rpx;
}
.header-icon {
  width: 66rpx;
  height: 66rpx;
}
.header-title {
  font-size: 28rpx;
  font-weight: 400;
  color: #000000;
  margin-top: 4rpx;
  font-family: Inter, Microsoft YaHei, sans-serif;
}

/* ============== 分类标签栏 ============== */
/* 胶囊 48×25px → 90×47rpx，间距 3px → 6rpx，圆角 4px → 8rpx */
.category-row {
  white-space: nowrap;
  padding: 24rpx 32rpx 22rpx;
  box-sizing: border-box;
}
.cat-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 90rpx;
  height: 47rpx;
  margin-right: 6rpx;
  background: #FBEEDF;
  color: #000000;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-family: Inter, Microsoft YaHei, sans-serif;
  box-sizing: border-box;
}
.cat-chip--active {
  background: #FFD9A6;
  font-weight: 500;
}
.cat-chip--add {
  color: #000000;
}

/* ============== 物品网格卡 ============== */
/* 卡片 363×288px → 686×538rpx，底 #FFF6F7，圆角 15px → 28rpx */
.item-grid-card {
  margin: 0 32rpx;
  background: #FFF6F7;
  border-radius: 28rpx;
  padding: 24rpx;
  min-height: 538rpx;
  box-sizing: border-box;
}
.item-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.grid-item {
  width: calc((100% - 48rpx) / 4);
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 16rpx 8rpx;
  box-sizing: border-box;
}
.grid-item:active {
  opacity: 0.6;
}
.grid-icon {
  width: 96rpx;
  height: 96rpx;
}
/* 卡片（梦卡片等）：配图当图标，方形裁切 */
.grid-icon--card {
  border-radius: 10rpx;
  background: #FFF6F7;
}
.grid-name {
  font-size: 20rpx;
  color: #000000;
  margin-top: 8rpx;
  font-family: Inter, Microsoft YaHei, sans-serif;
  text-align: center;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.grid-empty {
  width: 100%;
  text-align: center;
  color: #B69C7C;
  font-size: 22rpx;
  padding: 40rpx 0;
}

/* ============== 提示条 ============== */
/* 118×24px → 220×45rpx，字 12px → 22rpx / 300 */
.combo-hint {
  width: 220rpx;
  height: 45rpx;
  line-height: 45rpx;
  margin: 22rpx 32rpx 10rpx;
  padding-left: 10rpx;
  background: #FFF6F7;
  border-radius: 28rpx;
  font-size: 22rpx;
  font-weight: 300;
  color: rgba(0, 0, 0, 0.8);
  font-family: Inter, Microsoft YaHei, sans-serif;
  box-sizing: border-box;
}

/* ============== 组合槽位卡 ============== */
/* 卡 363×134px → 686×250rpx；槽位 94×94px → 175rpx，间距 29px → 54rpx */
.combo-card {
  margin: 0 32rpx;
  height: 250rpx;
  padding: 32rpx 0 0 22rpx;
  background: #FFF6F7;
  border-radius: 28rpx;
  display: flex;
  align-items: flex-start;
  gap: 54rpx;
  box-sizing: border-box;
}
.combo-slot {
  width: 175rpx;
  height: 175rpx;
  background: #FFE3E6;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.combo-slot--filled {
  background: #FFE3E6;
}
.combo-slot:active {
  opacity: 0.7;
}
.combo-icon {
  width: 140rpx;
  height: 140rpx;
}

/* ============== 留言 / 密封 ============== */
/* 100×24px → 187×45rpx，间距 23px → 43rpx */
.combo-actions {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
  gap: 43rpx;
}
.combo-btn {
  width: 187rpx;
  height: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF6F7;
  border-radius: 28rpx;
  font-size: 22rpx;
  font-weight: 300;
  color: rgba(0, 0, 0, 0.8);
  font-family: Inter, Microsoft YaHei, sans-serif;
}
.combo-btn--hover {
  opacity: 0.7;
}

/* ============== 底部信封（密封） ============== */
/* 圆 114px → 213rpx；信封图 103×112px → 192×209rpx */
.seal-wrap {
  position: relative;
  width: 213rpx;
  min-height: 213rpx;
  margin: 58rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.seal-circle {
  width: 213rpx;
  height: 213rpx;
  border-radius: 50%;
  background: #FAEEDF;
}
.seal-circle--hover {
  opacity: 0.85;
}
/* 猫拿走后圆心提示文案 */
.seal-tip {
  position: absolute;
  left: 0;
  top: 0;
  width: 213rpx;
  height: 213rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #6B5B4B;
  letter-spacing: 2rpx;
  pointer-events: none;
  animation: sealTipIn 320ms ease-out both;
}
@keyframes sealTipIn {
  from { opacity: 0; transform: scale(0.92); }
  to   { opacity: 1; transform: scale(1); }
}
/* 信件 103×112px（Figma 1186_123/1）：投影 5px 9px 3.8px 25% */
.seal-envelope {
  position: absolute;
  left: 10rpx;
  top: 2rpx;
  width: 192rpx;
  height: 209rpx;
  filter: drop-shadow(9rpx 17rpx 7rpx rgba(0, 0, 0, 0.25));
}
/* 猫的回信（Figma 1207_179）：同一封信 103×112px → 192×209rpx，
   图内自带「猫的回信」字样（12px / 居中） */
.reply-envelope {
  position: absolute;
  left: 10rpx;
  top: 2rpx;
  width: 192rpx;
  height: 209rpx;
  animation: envelopeIn 460ms cubic-bezier(0.22, 1.1, 0.36, 1) both,
             envelopeFloat 2400ms ease-in-out 460ms infinite;
}
.reply-envelope__img {
  display: block;
  width: 100%;
  height: 100%;
  filter: drop-shadow(9rpx 17rpx 7rpx rgba(0, 0, 0, 0.25));
}
.reply-envelope--hover {
  opacity: 0.92;
}
@keyframes envelopeIn {
  from { opacity: 0; transform: translateY(40rpx) scale(0.9); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes envelopeFloat {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-10rpx); }
}
/* 出现：从圆里浮起并放大 */
.seal-envelope--in {
  animation: sealIn 420ms cubic-bezier(0.22, 1.1, 0.36, 1) both;
}
/* 猫拿走：向上飘走并淡出 */
.seal-envelope--taken {
  animation: sealTaken 1100ms ease-in both;
}
@keyframes sealIn {
  from { opacity: 0; transform: translateY(56rpx) scale(0.86); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes sealTaken {
  0%   { opacity: 1; transform: translateY(0) scale(1); }
  35%  { opacity: 1; transform: translateY(-24rpx) scale(1.02); }
  100% { opacity: 0; transform: translateY(-170rpx) scale(0.9); }
}

/* ============== 猫的回信内容（Figma 1205_175）============== */
/* 卡 424×534px 按 1px ≈ 1.769rpx 做成 750×944rpx 后整体缩到 0.86 呈现
   （≈645×812rpx），内部各元素保持设计比例；底 #FBEEDF，猫对话框为透明底切图 */
.reply-card {
  width: 750rpx;
  height: 812rpx;
  margin: 58rpx auto 0;
  animation: replyIn 360ms ease-out both;
}
.reply-card__inner {
  position: relative;
  width: 750rpx;
  height: 944rpx;
  background: #FBEEDF;
  overflow: hidden;
  transform: scale(0.86);
  transform-origin: center top;
}
.reply-card__bg {
  display: block;
  width: 100%;
  height: 100%;
}
/* 正文 15px → 27rpx、行高 1.9em → 50rpx；left 62px → 110rpx，top 165px → 292rpx */
.reply-card__text {
  position: absolute;
  left: 110rpx;
  top: 292rpx;
  width: 620rpx;
  display: flex;
  flex-direction: column;
}
.reply-card__line {
  font-size: 27rpx;
  line-height: 50rpx;
  color: #000000;
  font-family: Inter, Microsoft YaHei, sans-serif;
}
/* 保存按钮 73×36px → 129×64rpx 后放大到 150×74rpx（水平仍居中，
   左 375-75），圆角 37rpx，白底 1px #FFDBB3 描边 */
.reply-card__save {
  position: absolute;
  left: 300rpx;
  top: 628rpx;
  width: 150rpx;
  height: 74rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border: 2rpx solid #FFDBB3;
  border-radius: 37rpx;
  box-sizing: border-box;
}
.reply-card__save-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #8A5A2B;
  font-family: Inter, Microsoft YaHei, sans-serif;
}
.reply-card__save--hover {
  opacity: 0.85;
}
/* 离屏画布：仅用于把回信卡合成成图片保存到相册 */
.reply-canvas {
  position: fixed;
  left: -2000rpx;
  top: 0;
  width: 848px;
  height: 1068px;
}
@keyframes replyIn {
  from { opacity: 0; transform: translateY(30rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ============== 浮动拖动层 ============== */
.drag-layer {
  position: fixed;
  width: 120rpx;
  height: 120rpx;
  margin-left: -60rpx;
  margin-top: -60rpx;
  z-index: 999;
  pointer-events: none;
}
.drag-icon {
  width: 100%;
  height: 100%;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.2));
}

/* ============== 留言弹窗 ============== */
.msg-modal {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}
.msg-modal__mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}
.msg-modal__sheet {
  position: relative;
  z-index: 1;
  background: #FFFFFF;
  border-radius: 28rpx 28rpx 0 0;
  padding: 16rpx 32rpx 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}
.msg-modal__handle {
  width: 80rpx;
  height: 8rpx;
  margin: 0 auto 20rpx;
  border-radius: 4rpx;
  background: #E5DCCB;
}
.msg-modal__title {
  font-size: 30rpx;
  font-weight: 500;
  font-family: Inter, Microsoft YaHei, sans-serif;
  color: #2F2F2F;
  margin-bottom: 20rpx;
}
.msg-modal__input {
  width: 100%;
  min-height: 160rpx;
  max-height: 300rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  background: #FBEEDF;
  border-radius: 18rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #2F2F2F;
  font-family: Inter, Microsoft YaHei, sans-serif;
}
.msg-modal__placeholder {
  color: #B69C7C;
}
.msg-modal__actions {
  margin-top: 26rpx;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}
.msg-modal__btn {
  flex: 1;
  height: 84rpx;
  border-radius: 42rpx;
  background: #FBEEDF;
  color: #8A5A2B;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}
.msg-modal__btn--active {
  background: #8A5A2B;
  color: #FFFFFF;
}
.msg-modal__btn--hover {
  opacity: 0.85;
}

/* ===== 底部导航：仅提供贴底定位，胶囊外观由 bottom-tab 组件自带 ===== */
.page-bottom-tab {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
}
