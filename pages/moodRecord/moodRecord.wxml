<!-- ============================================
  moodRecord - 情绪岛 / 火苗分享卡片页
  Figma 基准: 375 x 852 px -> 750 x 1704 rpx
  换算规则: 1 Figma px = 2 rpx
  数据来源: app.globalData.currentMoodRecord
  ============================================ -->

<view class="page">

  <!-- 隐藏 Canvas -- 用于生成火苗卡片截图（保存到相册） -->
  <canvas type="2d" id="shareCanvas" class="share-canvas"></canvas>

  <scroll-view class="page-body" scroll-y="true" enhanced="true" show-scrollbar="{{false}}">

  <!-- =================== 顶部：标题 + 统计卡片 =================== -->
  <view class="header">
    <view class="header-title">{{nickname}}心情库</view>
    <view class="header-subtitle">共 {{recordCount}} 条记录</view>

    <view class="stats-row">
      <view class="stat-card stat-purple">
        <text class="stat-label">平均热度</text>
        <text class="stat-value stat-value-purple">{{avgHeat}}</text>
      </view>
      <view class="stat-card stat-blue">
        <text class="stat-label">最常情绪</text>
        <text class="stat-value stat-value-mood">{{currentMoodType || '偷偷小得意'}}</text>
      </view>
      <view class="stat-card stat-green">
        <text class="stat-label">记录总数</text>
        <text class="stat-value stat-value-green">{{recordCount}}</text>
      </view>
    </view>
  </view>

  <!-- =================== 可滚动内容区 =================== -->
  <view class="scroll-body">

  <!-- =================== 主卡片（分层渲染） =================== -->
  <view class="main-card">

    <!-- 中层：星空纹理 -->
    <image class="card-starfield" src="/assets/moodRecord/starfield.png" mode="aspectFill"></image>

    <!-- 上层：卡牌紫色外发光遮罩 -->
    <view class="card-glow-overlay"></view>

    <!-- 头像行背景带 -->
    <view class="card-header-bg"></view>

    <!-- 内容层 -->
    <view class="card-inner">

      <!-- ---- 用户 + 日期行 + 条码 ---- -->
      <view class="card-user-row">
        <image class="card-avatar" src="{{userAvatar || '/assets/moodRecord/5.png'}}" mode="aspectFill"></image>
        <view class="card-user-info">
          <text class="card-user-name">{{nickname}}火苗卡</text>
          <text class="card-date">{{recordTime}}</text>
        </view>
        <!-- 条码 — 同行最右端 -->
        <view class="card-barcode-inline">
          <canvas type="2d" id="barcodeCanvas" class="barcode-canvas-inline"></canvas>
          <text class="barcode-id-inline">{{barcodeText}}</text>
        </view>
      </view>

      <!-- ---- 情绪统计 ---- -->
      <view class="card-emoji-section">
        <text class="card-heat">情绪热度 {{moodEnergy}}%</text>
        <text class="card-mood">{{currentMoodType || '超开心'}}</text>
        <text class="card-memo" wx:if="{{shareText}}">{{shareText}}</text>
      </view>

      <!-- ---- 今日语录 ---- -->
      <view class="card-quote" wx:if="{{eventText}}">"{{eventText}}"</view>

      <!-- ---- 星猫寄语卡片 ---- -->
      <view class="advice-card" wx:if="{{shareTip}}">
        <image class="advice-avatar" src="/assets/moodRecord/6.png" mode="aspectFit"></image>
        <text class="advice-text">{{shareTip}}</text>
      </view>

      <!-- ---- 操作按钮（紫/橙发光 + 扫光） ---- -->
      <view class="card-actions">
        <button class="btn-action btn-save" bindtap="onSave">保 存</button>
        <button class="btn-action btn-share" open-type="share">分 享</button>
      </view>

    </view>
  </view>

  </view>

  </scroll-view>

  <!-- =================== 底部导航栏（心情库激活） =================== -->
  <view class="tab-bar">
    <view class="tab-item" data-tab="moodIsland" bindtap="onTabSwitch">
      <image class="tab-icon" src="/assets/moodRecord/4.svg" mode="aspectFit"></image>
      <text class="tab-label">情绪岛</text>
    </view>
    <view class="tab-item active" data-tab="moodLib" bindtap="onTabSwitch">
      <image class="tab-icon" src="/assets/moodRecord/3.svg" mode="aspectFit"></image>
      <text class="tab-label">心情库</text>
    </view>
    <view class="tab-item" data-tab="starTalk" bindtap="onTabSwitch">
      <image class="tab-icon" src="/assets/moodRecord/2.svg" mode="aspectFit"></image>
      <text class="tab-label">星猫说</text>
    </view>
    <view class="tab-item" data-tab="people" bindtap="onTabSwitch">
      <image class="tab-icon" src="/assets/moodRecord/1.svg" mode="aspectFit"></image>
      <text class="tab-label">你我他</text>
    </view>
  </view>

</view>
