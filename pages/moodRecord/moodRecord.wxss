/* ============================================
   moodRecord - 心情库 / 情绪记录详情页
   Figma 基准: 375 × 852 px → 750 × 1704 rpx
   换算规则: 1 Figma px = 2 rpx
   全部 rpx，禁止 px
   ============================================ */

/* ---- 根元素 & 外层容器 ---- */
page {
  background: #ffffff;
  min-height: 100vh;
}

.page {
  width: 100%;
  height: 100vh;
  position: relative;
  background: #ffffff;
}

.page-body {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 60rpx;
  padding-bottom: calc(96rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.scroll-body {
  width: 100%;
}

/* ============================================
   顶部区域 — 标题 + 统计卡片
   Figma: 384×203px, left:-5, top:18
   ============================================ */

.header {
  padding-top: 36rpx;
  width: 100%;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #101828;
  line-height: 1.3;
}

.header-subtitle {
  font-size: 28rpx;
  font-weight: 400;
  color: #99A1AF;
  margin-top: 0;
}

/* ---- 统计卡片行 ---- */
.stats-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 22rpx;
}

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 138rpx;
  border-radius: 32rpx;
  gap: 6rpx;
}

.stat-purple {
  background: #F5F3FF;
}

.stat-blue {
  background: #F0F9FF;
}

.stat-green {
  background: #ECFDF5;
}

.stat-label {
  font-size: 20rpx;
  font-weight: 400;
  color: #99A1AF;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #000000;
}

.stat-value-purple {
  color: #7C3AED;
}

.stat-value-green {
  color: #009966;
}

.stat-value-mood {
  font-size: 28rpx;
  font-weight: 400;
  color: #000000;
}

/* ============================================
   主卡片 — 深色背景情绪记录卡
   Figma: 304×432px → 608×864rpx
   ============================================ */

.main-card {
  width: 100%;
  margin-top: 88rpx;
  background: #302D54;
  border-radius: 78rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.card-inner {
  width: 100%;
  box-sizing: border-box;
  padding: 30rpx 30rpx 20rpx 30rpx;
  display: flex;
  flex-direction: column;
}

/* ---- 用户 + 日期行 ---- */
.card-user-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.card-avatar {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
}

.card-user-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.card-user-name {
  font-size: 24rpx;
  font-weight: 290;
  color: #ffffff;
  line-height: 1.3;
}

.card-date {
  font-size: 24rpx;
  font-weight: 290;
  color: #ffffff;
  line-height: 1.3;
  opacity: 0.6;
}

/* ---- Emoji 情绪区 ---- */
.card-emoji-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 0;
}

.card-emoji {
  font-size: 86rpx;
  text-align: center;
  line-height: 1.2;
}

.card-heat {
  font-size: 24rpx;
  font-weight: 290;
  color: #ffffff;
  text-align: center;
  margin-top: 4rpx;
}

.card-mood {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  text-align: center;
  margin-top: 4rpx;
}

.card-memo {
  font-size: 24rpx;
  font-weight: 290;
  color: #ffffff;
  text-align: center;
  margin-top: 4rpx;
}

/* ---- 语录 ---- */
.card-quote {
  font-size: 48rpx;
  font-weight: 290;
  color: #ffffff;
  text-align: center;
  margin-top: 10rpx;
  line-height: 1.3;
}

/* ---- 星猫寄语卡片 ---- */
.advice-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: rgba(203, 179, 255, 0.33);
  border-radius: 48rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.38);
  padding: 30rpx 20rpx;
  margin-top: 30rpx;
  gap: 14rpx;
}

.advice-avatar {
  width: 122rpx;
  height: 122rpx;
  flex-shrink: 0;
}

.advice-text {
  font-size: 32rpx;
  font-weight: 400;
  color: #ffffff;
  flex: 1;
  line-height: 1.5;
}

/* ---- 操作按钮 ---- */
.card-actions {
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 32rpx;
  margin-top: 36rpx;
}

.btn-action {
  width: 170rpx;
  height: 48rpx;
  background: rgba(97, 85, 245, 0.50);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 400;
  color: #ffffff;
}

/* ============================================
   底部导航栏（与 moodAdd 一致，激活"心情库"）
   ============================================ */

.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: #ffffff;
  width: 100%;
  height: 96rpx;
  padding: 0 60rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #000000;
}

.tab-item.active .tab-label {
  color: #6155F5;
  font-weight: 700;
}
