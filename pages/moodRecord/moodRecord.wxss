/* ============================================
   moodRecord - 心情库 / 情绪记录详情页
   Figma 基准: 375 x 852 px -> 750 x 1704 rpx
   换算规则: 1 Figma px = 2 rpx
   全部 rpx，禁止 px
   ============================================ */

/* ---- 根元素 & 外层容器 ---- */
page {
  background: #ffffff;
  min-height: 100vh;
}

.page {
  width: 100%;
  height: 100vh;
  position: relative;
  background: #ffffff;
}

/* ---- 隐藏 Canvas（离屏渲染，用于生成火苗卡片截图） ---- */
.share-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 608rpx;
  height: 864rpx;
  pointer-events: none;
}

.page-body {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 60rpx;
  padding-bottom: calc(96rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.scroll-body {
  width: 100%;
}

/* ============================================
   顶部区域 — 标题 + 统计卡片
   Figma: 384x203px, left:-5, top:18
   ============================================ */

.header {
  padding-top: 36rpx;
  width: 100%;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #101828;
  line-height: 1.3;
}

.header-subtitle {
  font-size: 28rpx;
  font-weight: 400;
  color: #99A1AF;
  margin-top: 0;
}

/* ---- 统计卡片行 ---- */
.stats-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 22rpx;
}

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 138rpx;
  border-radius: 32rpx;
  gap: 6rpx;
}

.stat-purple {
  background: #F5F3FF;
}

.stat-blue {
  background: #F0F9FF;
}

.stat-green {
  background: #ECFDF5;
}

.stat-label {
  font-size: 20rpx;
  font-weight: 400;
  color: #99A1AF;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #000000;
}

.stat-value-purple {
  color: #7C3AED;
}

.stat-value-green {
  color: #009966;
}

.stat-value-mood {
  font-size: 28rpx;
  font-weight: 400;
  color: #000000;
}

/* ============================================
   主卡片 — 分层渲染
   底层: #302D54 | 中层: 星空纹理 | 上层: 紫色外发光
   ============================================ */

.main-card {
  width: 100%;
  margin-top: 88rpx;
  background: #302D54;
  border-radius: 78rpx;
  overflow: hidden;
  flex-shrink: 0;
  position: relative;
  /* 卡牌紫色外发光 */
  box-shadow: 0 0 60rpx rgba(124, 58, 237, 0.28),
              0 0 120rpx rgba(124, 58, 237, 0.12),
              0 8rpx 32rpx rgba(0, 0, 0, 0.3);
}

/* ---- 中层：星空纹理 ---- */
.card-starfield {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  opacity: 0.55;
  pointer-events: none;
}

/* ---- 上层：紫色外发光遮罩 ---- */
.card-glow-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
  pointer-events: none;
  background: radial-gradient(circle at 50% 25%, rgba(124, 58, 237, 0.18) 0%, transparent 60%);
}

/* ---- 头像行背景带（星空层之上，内容层之下） ---- */
.card-header-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 110rpx;
  z-index: 3;
  background: #260D34;
  border-radius: 78rpx 78rpx 0 0;
  pointer-events: none;
}

/* ---- 内容层 ---- */
.card-inner {
  position: relative;
  z-index: 4;
  width: 100%;
  box-sizing: border-box;
  padding: 30rpx 30rpx 24rpx 30rpx;
  display: flex;
  flex-direction: column;
}

/* ---- 用户 + 日期行 + 条码 ---- */
.card-user-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.card-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}

.card-user-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.card-user-name {
  font-size: 24rpx;
  font-weight: 290;
  color: #ffffff;
  line-height: 1.3;
}

.card-date {
  font-size: 24rpx;
  font-weight: 290;
  color: #ffffff;
  line-height: 1.3;
  opacity: 0.6;
}

/* ---- 条码（同行最右端） ---- */
.card-barcode-inline {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  margin-left: auto;
  margin-right: 4rpx;
  flex-shrink: 0;
}

.barcode-canvas-inline {
  width: 140rpx;
  height: 36rpx;
  border-radius: 4rpx;
}

.barcode-id-inline {
  font-size: 16rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.45);
  font-family: monospace;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

/* ---- 火焰图标 + 情绪区 ---- */
.card-emoji-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 0;
}

/* 火焰包裹容器（用于闪光定位） */
.flame-wrapper {
  position: relative;
  width: 96rpx;
  height: 96rpx;
}

.card-emoji-img {
  width: 96rpx;
  height: 96rpx;
  display: block;
}

/* ---- 火焰闪光 ---- */
.flame-spark {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.9) 0%, rgba(255, 200, 50, 0.6) 30%, transparent 70%);
  pointer-events: none;
  opacity: 0;
}

.flame-spark.s1 {
  width: 12rpx;
  height: 12rpx;
  top: 6rpx;
  right: 10rpx;
  animation: sparkFloat1 1.8s ease-in-out infinite;
}

.flame-spark.s2 {
  width: 10rpx;
  height: 10rpx;
  top: 20rpx;
  left: 4rpx;
  animation: sparkFloat2 2.2s ease-in-out 0.4s infinite;
}

.flame-spark.s3 {
  width: 8rpx;
  height: 8rpx;
  bottom: 14rpx;
  right: 8rpx;
  animation: sparkFloat3 1.5s ease-in-out 0.8s infinite;
}

.flame-spark.s4 {
  width: 14rpx;
  height: 14rpx;
  top: -4rpx;
  left: 20rpx;
  animation: sparkFloat1 2.0s ease-in-out 1.2s infinite;
}

@keyframes sparkFloat1 {
  0%   { opacity: 0; transform: scale(0.3) translateY(0); }
  30%  { opacity: 0.9; transform: scale(1.0) translateY(-8rpx); }
  60%  { opacity: 0.3; transform: scale(0.6) translateY(-14rpx); }
  100% { opacity: 0; transform: scale(0.1) translateY(-22rpx); }
}

@keyframes sparkFloat2 {
  0%   { opacity: 0; transform: scale(0.2) translateY(0) translateX(0); }
  25%  { opacity: 0.85; transform: scale(1.1) translateY(-6rpx) translateX(6rpx); }
  50%  { opacity: 0.4; transform: scale(0.7) translateY(-10rpx) translateX(10rpx); }
  100% { opacity: 0; transform: scale(0.1) translateY(-20rpx) translateX(16rpx); }
}

@keyframes sparkFloat3 {
  0%   { opacity: 0; transform: scale(0.4) translateY(0); }
  35%  { opacity: 0.8; transform: scale(0.9) translateY(-10rpx); }
  70%  { opacity: 0.2; transform: scale(0.5) translateY(-16rpx); }
  100% { opacity: 0; transform: scale(0.1) translateY(-24rpx); }
}

.card-heat {
  font-size: 24rpx;
  font-weight: 290;
  color: #ffffff;
  text-align: center;
  margin-top: 8rpx;
}

.card-mood {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  text-align: center;
  margin-top: 4rpx;
}

.card-memo {
  font-size: 24rpx;
  font-weight: 290;
  color: #ffffff;
  text-align: center;
  margin-top: 4rpx;
}

/* ---- 语录 ---- */
.card-quote {
  font-size: 48rpx;
  font-weight: 290;
  color: #ffffff;
  text-align: center;
  margin-top: 10rpx;
  line-height: 1.3;
}

/* ---- 星猫寄语卡片 ---- */
.advice-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: rgba(203, 179, 255, 0.33);
  border-radius: 48rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.38);
  padding: 30rpx 20rpx;
  margin-top: 30rpx;
  gap: 14rpx;
}

.advice-avatar {
  width: 122rpx;
  height: 122rpx;
  flex-shrink: 0;
}

.advice-text {
  font-size: 32rpx;
  font-weight: 400;
  color: #ffffff;
  flex: 1;
  line-height: 1.5;
}

/* ============================================
   操作按钮 — 紫色发光 + 扫光
   ============================================ */

.card-actions {
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 32rpx;
  margin-top: 36rpx;
  padding: 0 60rpx;
}

.btn-action {
  width: 140rpx;
  height: 48rpx;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 400;
  color: #ffffff;
  line-height: 48rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.btn-action::after {
  border: none;
}

/* 保存按钮 — 紫色发光 */
.btn-save {
  background: rgba(97, 85, 245, 0.55);
  box-shadow: 0 0 16rpx rgba(124, 58, 237, 0.5),
              0 4rpx 8rpx rgba(0, 0, 0, 0.2);
}

/* 分享按钮 — 紫色发光 */
.btn-share {
  background: rgba(97, 85, 245, 0.55);
  box-shadow: 0 0 16rpx rgba(97, 85, 245, 0.5),
              0 4rpx 8rpx rgba(0, 0, 0, 0.2);
}

/* ---- 扫光动画 ---- */
.btn-action::before {
  content: '';
  position: absolute;
  top: 0;
  left: -60%;
  width: 50%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  animation: btnSweep 2.5s ease-in-out infinite;
  pointer-events: none;
}

@keyframes btnSweep {
  0% { left: -60%; }
  100% { left: 160%; }
}

/* ---- 按钮点击反馈 ---- */
.btn-action:active {
  opacity: 0.7;
}

.btn-save:active {
  background: rgba(97, 85, 245, 0.75);
}

.btn-share:active {
  background: rgba(97, 85, 245, 0.75);
}

/* ============================================
   底部导航栏（与 moodAdd 一致，激活"心情库"）
   ============================================ */

.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: #ffffff;
  width: 100%;
  height: 96rpx;
  padding: 0 60rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #000000;
}

.tab-item.active .tab-label {
  color: #6155F5;
  font-weight: 700;
}
