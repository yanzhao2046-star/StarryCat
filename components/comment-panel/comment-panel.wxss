/* ============================================
   comment-panel 评论面板样式
   独立样式，不污染页面
   Figma 基准: 375px → 1px = 2rpx
   ============================================ */

/* ---- 外层容器（30rpx 边距） ---- */
.cp-container {
  width: 100%;
  padding: 24rpx 30rpx;
  box-sizing: border-box;
  background: rgba(255, 241, 242, 0.68);
  border-radius: 46rpx;
}

/* ============================================
   评论输入区域
   ============================================ */
.cp-input-area {
  width: 100%;
  margin-bottom: 20rpx;
}

/* ---- 回复目标提示栏 ---- */
.cp-reply-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
  padding: 0 4rpx;
}

.cp-reply-info {
  font-size: 20rpx;
  font-weight: 400;
  font-family: Microsoft YaHei UI, sans-serif;
  color: #6155F5;
}

.cp-reply-cancel {
  font-size: 20rpx;
  font-weight: 400;
  font-family: Microsoft YaHei UI, sans-serif;
  color: rgba(0, 0, 0, 0.40);
  padding: 4rpx 12rpx;
}

.cp-reply-cancel:active {
  color: #6155F5;
}

/* ---- 输入框 + 发送按钮 ---- */
.cp-input-wrap {
  width: 100%;
  height: 68rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  border: 2rpx solid #E8D6FC;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 16rpx 0 20rpx;
}

.cp-input {
  flex: 1;
  height: 100%;
  font-size: 22rpx;
  font-weight: 400;
  font-family: Microsoft YaHei UI, sans-serif;
  color: #000000;
}

.cp-placeholder {
  font-size: 22rpx;
  font-weight: 290;
  color: rgba(0, 0, 0, 0.35);
}

/* ---- 发送按钮 ---- */
.cp-send-btn {
  margin-left: 12rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(97, 85, 245, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cp-send-btn text {
  font-size: 20rpx;
  font-weight: 600;
  font-family: Microsoft YaHei UI, sans-serif;
  color: #6155F5;
}

.cp-send-btn--active {
  background: #6155F5;
}

.cp-send-btn--active text {
  color: #FFFFFF;
}

.cp-send-btn:active {
  opacity: 0.85;
}

/* ============================================
   状态提示（加载/空态）
   ============================================ */
.cp-status {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

.cp-status-text {
  font-size: 22rpx;
  font-weight: 290;
  font-family: Microsoft YaHei UI, sans-serif;
  color: rgba(0, 0, 0, 0.40);
}

/* ============================================
   评论列表
   ============================================ */
.cp-list {
  display: flex;
  flex-direction: column;
}

/* ---- 单条评论 ---- */
.cp-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

/* ---- 头像（左侧） ---- */
.cp-avatar {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 2rpx;
}

/* ---- 内容体 ---- */
.cp-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 14rpx;
  overflow: hidden;
}

/* ---- 昵称+内容行 ---- */
.cp-title-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: flex-start;
}

.cp-nick {
  font-size: 20rpx;
  font-weight: 600;
  font-family: Microsoft YaHei UI, sans-serif;
  color: #000000;
  line-height: 1.5;
  flex-shrink: 0;
}

.cp-reply-at {
  font-weight: 400;
  color: rgba(0, 0, 0, 0.55);
}

.cp-text {
  font-size: 20rpx;
  font-weight: 400;
  font-family: Microsoft YaHei UI, sans-serif;
  color: #000000;
  line-height: 1.5;
  word-break: break-all;
  flex: 1;
}

/* ---- 时间+回复按钮行 ---- */
.cp-meta-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 4rpx;
  gap: 16rpx;
}

.cp-time {
  font-size: 18rpx;
  font-weight: 290;
  font-family: Microsoft YaHei UI, sans-serif;
  color: rgba(0, 0, 0, 0.40);
  line-height: 1.3;
}

.cp-reply-btn {
  font-size: 18rpx;
  font-weight: 400;
  font-family: Microsoft YaHei UI, sans-serif;
  color: #6155F5;
  line-height: 1.3;
  padding: 2rpx 8rpx;
}

.cp-reply-btn:active {
  opacity: 0.6;
}

/* ---- 楼中楼回复（缩进展示） ---- */
.cp-item--reply {
  padding-left: 46rpx;
}

.cp-item--reply .cp-avatar {
  width: 28rpx;
  height: 28rpx;
}

.cp-item--reply .cp-nick {
  font-weight: 500;
}
